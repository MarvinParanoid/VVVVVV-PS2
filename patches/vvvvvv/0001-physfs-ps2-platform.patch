+/* ps2sdk file calls are never interrupted, but a failed call can leave a
+ * driver status code in errno: on a real PS2, open() of a missing file on a
+ * USB stick (mass:) sets errno 4, which is EINTR, and the retry loops below
+ * then spin forever (found on the first console test, 2026-10-26). */
+#define RETRY_EINTR(failed) 0
+#else
+#define RETRY_EINTR(failed) ((failed) && (errno == EINTR))
+#endif
