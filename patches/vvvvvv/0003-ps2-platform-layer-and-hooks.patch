+/* PlayStation 2 platform layer: SDL configuration and instrumentation.
+ * Everything here is compiled only for the PS2 build (CMake adds
+ * PS2Platform.cpp when PS2 is set); call sites are guarded by __PS2__. */
+
+#include <stddef.h>
+#include <stdint.h>
