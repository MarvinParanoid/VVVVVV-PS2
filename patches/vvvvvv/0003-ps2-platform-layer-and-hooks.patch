@@ -0,0 +1,45 @@
+#ifndef PS2BENCH_H
+#define PS2BENCH_H
+
+/* PS2 scene benchmark (PS2 build only, enabled by a bench.txt next to the
+ * ELF). Drives the game into fixed scenes with its own entry points
+ * (startgamemode, gotoroom, map menu), records per-frame timings split into
+ * logic / game draw calls / SDL software rasterisation / GS upload / vsync,
+ * samples the EE program counter for a profile, and checks optimisations
+ * with an A/B render of one frozen game state (docs/ps2-p3-report.md). */
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Runtime switches for the P3 rendering optimisations (bitmask). The A/B
+ * pixel check renders the same frozen frame with 0 and with the enabled set. */
+#define PS2_OPT_TARGET_ABGR 0x1u    /* render targets in the textures' ABGR8888 layout */
+#define PS2_OPT_SDL_FASTPATHS 0x2u  /* SDL_PS2_P3_FASTPATHS (SDL patches 0004-0006) */
+#define PS2_OPT_WINDOW_CLEARS 0x4u  /* skip window clears that render() overwrites anyway */
+#define PS2_OPT_OPAQUE_SCROLL 0x8u  /* no effect: those targets are already blend NONE (P3.1) */
+#define PS2_OPT_FLIP_FASTPATH 0x10u /* SDL_SW_FLIP_FASTPATH (SDL patch 0008, P3.1) */
+#define PS2_OPT_ALL 0xffffffffu
+extern uint32_t ps2_opts;
+/* diagnostics counted by game code */
+extern uint32_t ps2_tower_full_redraws;
+
+void PS2Bench_Init(void);
+int PS2Bench_Active(void);
+void PS2Bench_LoopBegin(uint64_t now_us);
+void PS2Bench_LoopEnd(void);
+void PS2Bench_LogicBegin(void);
+void PS2Bench_LogicEnd(void);
+void PS2Bench_RenderBegin(void);
+void PS2Bench_RenderEnd(void);
+int PS2Bench_LogicFrozen(void);
+int PS2Bench_WantsVerify(void);
+void PS2Bench_Verify(void (*render)(void));
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS2BENCH_H */
