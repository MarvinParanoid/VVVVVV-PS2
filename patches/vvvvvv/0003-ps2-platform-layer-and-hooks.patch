+/* ---- boot console ---- */
+static volatile int halted;
+static bool console_active;   /* the libdebug text screen owns the GS */
+static bool renderer_ready;   /* the game's renderer owns the GS */
+static char last_stage[96] = "(none)";
+static char last_error[120];
+/* the last few errors/warnings, oldest first, for the fatal screen */
+static char recent[6][120];
+static int recent_next;
+static bool bootshot; /* bootshot.txt (host: tests): save the boot console before the renderer starts */
+/* stages seen before the log file exists, replayed into it by PS2Diag_Init */
+static char early[1024];
+static size_t early_len;
+
+/* libdebug text: 80 x 40 cells of 8x8. Rows are kept in a small buffer and
+ * each one is placed explicitly (scr_setXY), so the screen can be redrawn
+ * and no line depends on the console's own cursor or wrap-around. */
+static char screen_text[40][80];
+static uint32_t screen_colour[40];
+static int console_row;
+
+static void screen_reset(void)
+{
+    memset(screen_text, 0, sizeof(screen_text));
+}
+
+static void text_at(int row, uint32_t colour, const char *text)
+{
+    if (row < 0 || row >= 38)
+    {
+        return; /* keep the screen; the log file has everything */
+    }
+    SDL_snprintf(screen_text[row], sizeof(screen_text[row]), "  %.76s", text);
+    screen_colour[row] = colour;
+}
+
+static void screen_show(void)
+{
+    for (int row = 0; row < 40; row++)
+    {
+        if (screen_text[row][0])
+        {
+            scr_setXY(0, row);
+            scr_setfontcolor(screen_colour[row]);
+            scr_printf("%s", screen_text[row]);
+        }
+    }
+}
+
+static void show_row(int row)
+{
+    scr_setXY(0, row);
+    scr_setfontcolor(screen_colour[row]);
+    scr_printf("%s", screen_text[row]);
+}
+
+static void console_open(void)
+{
+    if (console_active || renderer_ready)
+    {
+        return;
+    }
+    init_scr();
+    scr_setCursor(0);
+    console_active = true;
+    screen_reset();
+    console_row = 1;
+    text_at(console_row++, WHITE, "VVVVVV for PlayStation 2 - experimental test build " VVV_PS2_BUILD_ID);
+    text_at(console_row++, WHITE, "start-up (the title screen replaces this text):");
+    console_row++;
+    screen_show();
+}
+
+static void console_line(uint32_t colour, const char *text)
+{
+    if (!console_active)
+    {
+        return;
+    }
+    text_at(console_row, colour, text);
+    if (console_row < 38)
+    {
+        show_row(console_row);
+    }
+    console_row++;
+}
