+/* PS2 on-console diagnostics for hardware tests (PS2 build only):
+ *  - a text "boot console" (ps2sdk libdebug) listing start-up stages until
+ *    the game's renderer takes over the screen;
+ *  - a fatal screen that stays up instead of exiting (failed start-up,
+ *    VVV_exit with an error, CPU exceptions);
+ *  - the last error/warning logged, for the log file and the overlay;
+ *  - an optional overlay (L3+R3, or overlay.txt) with ticks/s, frame and
+ *    render time, music, underruns and free memory, redrawn once a second.
+ * See docs/ps2-h1-hardware-readiness.md. */
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void PS2Diag_Init(void); /* boot console + exception screen; first thing in PS2_PreInit */
+void PS2Diag_Stage(const char *fmt, ...);
+void PS2Diag_RendererReady(void); /* the game owns the GS from now on */
+void PS2Diag_Message(char level, const char *text); /* from vlog_*: 'E', 'W', 'I' */
+const char *PS2Diag_LastError(void);
+#ifdef __cplusplus
+[[noreturn]]
+#endif
+void PS2Diag_Fatal(const char *what);
+
+/* overlay and its statistics */
+void PS2Diag_Tick(void);                               /* one logic tick */
+void PS2Diag_Frame(uint32_t period_us, uint32_t render_us); /* once per loop */
+void PS2Diag_DrawOverlay(void);                        /* after render(), window is the target */
+void PS2Diag_SetOverlay(int on);
+void PS2Diag_SetStatus(const char *text); /* shown on the overlay's last line when there is no error */
+int PS2Diag_OverlayOn(void);
+
+/* set once a fatal/exception screen owns the display; the main loop then stops */
+int PS2Diag_Halted(void);
+/* build identity shown on every diagnostic screen and in the log */
+const char *PS2Diag_BuildId(void);
+
+#ifdef __cplusplus
+}
+#endif
