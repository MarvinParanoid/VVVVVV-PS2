+/* Before SDL_Init: SDL hints for the PS2 backend, log setup. */
+void PS2_PreInit(int argc, char *argv[]);
+/* After SDL_Init: thread priorities, controller report. */
+void PS2_PostInit(void);
+
+/* Main loop instrumentation (one deltaloop() per Begin/End pair). */
+void PS2_LoopBegin(void);
+void PS2_LoopEnd(void);
+void PS2_RenderBegin(void);
+void PS2_RenderEnd(void);
+
+/* Asset loading instrumentation (FILESYSTEM_loadAssetToMemory). */
+uint64_t PS2_NowUs(void);
+void PS2_LogAssetLoad(const char *name, size_t bytes, uint64_t us);
+
+void PS2_Log(const char *fmt, ...);
+/* Benchmark support: hold back log file writes while measuring; GS snapshot. */
+void PS2_LogDefer(int defer);
+void PS2_LogFlushNow(void); /* synchronous; for the fatal screen */
+int PS2_OnRealStorage(void); /* not PCSX2/ps2link host: */
+void PS2_Snapshot(const char *tag);
+
+#ifdef __cplusplus
+}
+#endif
