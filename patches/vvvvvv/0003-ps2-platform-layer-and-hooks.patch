+#include "Music.h"
+#include "PS2Diag.h"
+#include "PS2Platform.h"
+#include "Screen.h"
+#include "Script.h"
+#include "UtilityClass.h"
+
+uint32_t ps2_opts = PS2_OPT_ALL;
+uint32_t ps2_tower_full_redraws;
+static uint32_t tower_redraws0;
+
+/* Diagnostics exported by this repo's SDL patches (0001 GS backend, 0003
+ * software renderer); layouts must match the definitions there. */
+extern "C" {
+typedef struct
+{
+    uint64_t presents, update_us, queue_build_us, exec_us, finish_us, vsync_us;
+    uint32_t os_queue_size, per_queue_size, os_queue_peak, per_queue_peak, early_flushes, oversize_drops;
+} PS2_RenderStats;
+extern PS2_RenderStats PS2_render_stats;
+
+typedef struct
+{
+    uint64_t runs, queue_us, cmds[16];
+    uint64_t dead_clears;
+    struct
+    {
+        uint32_t src_format, dst_format, blend, mod;
+        uint64_t count, pixels;
+    } kinds[24];
+} SW_RenderStats;
+extern SW_RenderStats SW_render_stats;
+extern int SW_render_stats_kinds;
+
+/* patch 0008: how flipped copies were done (P3.2) */
+typedef struct
+{
+    uint32_t fast, fallback, scratch_allocs, scratch_alloc_failures;
+} SDL_SWFlipStats;
+extern SDL_SWFlipStats SDL_sw_flip_stats;
+}
+
+/* SDL_RenderCommandType values (SDL_sysrender.h) */
+enum
+{
+    CMD_SETVIEWPORT = 1, CMD_SETCLIPRECT, CMD_SETDRAWCOLOR, CMD_CLEAR, CMD_DRAW_POINTS,
+    CMD_DRAW_LINES, CMD_FILL_RECTS, CMD_COPY, CMD_COPY_EX, CMD_GEOMETRY
+};
+
+/* ---- configuration (bench.txt: key=value lines) ---- */
+static int enabled;
+static int cfg_settle_s = 4, cfg_measure_s = 20, cfg_over30 = -1, cfg_profile = 1, cfg_verify = 1, cfg_golden_ticks = 90;
+static int cfg_overlay;
+/* flip=1: run the scenes in Flip Mode (graphics.setflipmode, applied by
+ * startgamemode), to measure the flipped-text and flipped-frame paths */
+static int cfg_flip;
+/* tag=NAME: suffix for every output file (bench_results_NAME.txt, CSVs,
+ * profiles, golden frames, and a copy of the log as vvvvvv_ps2_NAME.log), so
+ * several configurations can run from one folder on a console without
+ * overwriting each other (P3.2) */
+static char cfg_tag[17];
+static char tag_sfx[18]; /* "" or "_NAME" */
+/* compact per-scene summary, written once as bench_results.txt at the end */
+static char results[4096];
+static size_t results_len;
+
+static void result_line(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    const int n = SDL_vsnprintf(results + results_len, sizeof(results) - results_len, fmt, ap);
+    va_end(ap);
+    if (n > 0 && results_len + n < sizeof(results))
+    {
+        results_len += n;
+    }
+}
+static char cfg_scenes[256];
+
+/* ---- per-frame records ---- */
+struct Frame
+{
+    uint32_t period_us, logic_us, ticks, render_us;
+    uint32_t sw_us, gs_upload_us, gs_dma_us, vsync_us;
+    uint32_t copies, fills, cmds, decode_us;
+};
+#define MAX_FRAMES 4000
+static Frame* frames;
+static int n_frames;
+static Frame cur;
+static uint64_t loop_start_us, logic_t0, render_t0;
+static PS2_RenderStats gs0;
+static SW_RenderStats sw0, sw_scene0;
+static SDL_SWFlipStats flip_scene0;
+#ifdef VVV_MUSIC_STREAMING
+static uint64_t decode_total0;
+static uint32_t underruns0;
+#endif
+
+/* ---- sampling profiler: EE timer counter alarm, records the interrupted PC ---- */
+#define PROF_HZ 1009 /* prime, so it does not lock to the 60 Hz frame */
+#define PROF_CAP 40000
+static uint32_t* prof_buf;
+static volatile uint32_t prof_n;
+static volatile int prof_on;
+static s32 prof_id = -1;
+static u64 prof_period;
+static volatile uint32_t prof_calls;
+
+static u64 prof_handler(s32 id, u64 scheduled_time, u64 actual_time, void* arg, void* pc_value)
+{
+    (void) id;
+    (void) scheduled_time;
+    (void) actual_time;
+    (void) arg;
+    prof_calls++;
+    if (prof_on && prof_n < PROF_CAP)
+    {
+        prof_buf[prof_n++] = (uint32_t) (uintptr_t) pc_value;
+    }
+    /* one-shot alarm: re-arm for the next sample */
+    iSetTimerAlarm(prof_period, prof_handler, NULL);
+    return 0;
+}
+
+static void prof_start(void)
+{
+    if (prof_id >= 0)
+    {
+        return;
+    }
+    prof_buf = (uint32_t*) malloc(sizeof(uint32_t) * PROF_CAP);
+    prof_period = kBUSCLK / PROF_HZ;
+    prof_id = prof_buf != NULL ? SetTimerAlarm(prof_period, prof_handler, NULL) : -1;
+    if (prof_id < 0)
+    {
+        PS2_Log("BENCH profiler unavailable (alarm %d)", (int) prof_id);
+        return;
+    }
+}
+
+/* ---- scenes ---- */
+static void place_player(int x, int y)
+{
+    const int i = obj.getplayer();
+    if (INBOUNDS_VEC(i, obj.entities))
+    {
+        obj.entities[i].xp = x;
+        obj.entities[i].yp = y;
+        obj.entities[i].lerpoldxp = x;
+        obj.entities[i].lerpoldyp = y;
+    }
+}
+
+static void s_title(void)
+{
+    if (game.gamestate != TITLEMODE)
+    {
+        game.quittomenu();
+    }
+}
+static void s_intro(void) { script.startgamemode(Start_MAINGAME); }
+static void s_ss1(void) { script.startgamemode(Start_TIMETRIAL_SPACESTATION1); }
+static void s_lab(void) { script.startgamemode(Start_TIMETRIAL_LABORATORY); }
+static void s_warp(void) { script.startgamemode(Start_TIMETRIAL_WARPZONE); }
+static void s_map(void) { game.mapmenuchange(MAPMODE, true); }
+static void s_tower(void)
+{
+    script.startgamemode(Start_TIMETRIAL_TOWER);
+    map.invincibility = true;
+    place_player(150, 193);
+    map.gotoroom(109, 109);
+}
+/* Typical tower play: the camera scrolls on its own and a player who climbs
+ * stays on screen, so only new rows of the background are drawn. An idle
+ * player falls behind the camera instead, which makes the game redraw the
+ * whole background every tick (the "tower"/"panic_room" worst cases, also
+ * what happens while falling or respawning). */
+static bool ride_camera;
+static void s_tower_climb(void)
+{
+    s_tower();
+    ride_camera = true;
+}
+static void s_panic(void)
+{
+    script.startgamemode(Start_TIMETRIAL_FINALLEVEL);
+    map.invincibility = true;
+    place_player(150, 40);
+    map.gotoroom(49, 52);
+}
+static void s_gravitron(void)
+{
+    map.invincibility = false; /* set by the tower scenes; the Gravitron refuses it */
+    script.startgamemode(Start_SECRETLAB);
+    map.gotoroom(119, 108);
+    place_player(148, 100);
+    game.setstate(9); /* what the Super Gravitron trigger does */
+}
+
+struct Scene
+{
+    const char* name;
+    void (*setup)(void);
+    int extra_settle_s;
+};
+static const Scene scenes[] = {
+    {"title", s_title, 0},
+    {"intro_dialogue", s_intro, 6},
+    {"room_ss1", s_ss1, 5},
+    {"map", s_map, 0},
+    {"room_lab", s_lab, 5},
+    {"warpzone", s_warp, 5},
+    {"tower", s_tower, 5},
+    {"tower_climb", s_tower_climb, 5},
+    {"panic_room", s_panic, 5},
+    {"super_gravitron", s_gravitron, 4},
+};
+#define NUM_SCENES ((int) SDL_arraysize(scenes))
+
+enum Phase
+{
+    P_BOOT, P_GOLDEN, P_GOLDEN_CAPTURE, P_SETTLE, P_MEASURE, P_FREEZE, P_VERIFY, P_SNAPSHOT, P_NEXT, P_DONE
+};
+static Phase phase = P_BOOT;
+static int scene = -1;
+static uint64_t phase_t0, measure_t0, measure_t1;
+static int phase_loops;
+static int frozen, want_verify, want_golden;
+/* pass 0: golden frames (driven only by logic tick counts, so the game state
+ * is the same in every build); pass 1: timed measurements */
+static int pass;
+
+static bool scene_selected(int i)
+{
+    if (cfg_scenes[0] == '\0')
+    {
+        return true;
+    }
+    /* whole comma-separated names only ("tower" must not match "tower_climb") */
+    const size_t n = strlen(scenes[i].name);
+    for (const char* p = strstr(cfg_scenes, scenes[i].name); p != NULL; p = strstr(p + 1, scenes[i].name))
+    {
+        if ((p == cfg_scenes || p[-1] == ',') && (p[n] == '\0' || p[n] == ',' || p[n] == '\n' || p[n] == '\r'))
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+void PS2Bench_Init(void)
+{
+    char buf[512];
+    int fd = open("bench.txt", O_RDONLY);
+    if (fd < 0)
+    {
+        return;
+    }
+    const int n = read(fd, buf, sizeof(buf) - 1);
+    close(fd);
+    buf[n > 0 ? n : 0] = '\0';
+    for (char* line = strtok(buf, "\r\n"); line != NULL; line = strtok(NULL, "\r\n"))
+    {
+        char* eq = strchr(line, '=');
+        if (eq == NULL)
+        {
+            continue;
+        }
+        *eq = '\0';
+        const char* v = eq + 1;
+        if (strcmp(line, "settle") == 0) cfg_settle_s = atoi(v);
+        else if (strcmp(line, "measure") == 0) cfg_measure_s = atoi(v);
+        else if (strcmp(line, "over30") == 0) cfg_over30 = atoi(v);
+        else if (strcmp(line, "profile") == 0) cfg_profile = atoi(v);
+        else if (strcmp(line, "verify") == 0) cfg_verify = atoi(v);
+        else if (strcmp(line, "golden") == 0) cfg_golden_ticks = atoi(v);
+        else if (strcmp(line, "kinds") == 0) SW_render_stats_kinds = atoi(v); /* copy kinds; costs ~2% */
+        else if (strcmp(line, "opts") == 0) ps2_opts = (uint32_t) strtoul(v, NULL, 0);
+        else if (strcmp(line, "scenes") == 0) SDL_strlcpy(cfg_scenes, v, sizeof(cfg_scenes));
+        else if (strcmp(line, "overlay") == 0) cfg_overlay = atoi(v);
+        else if (strcmp(line, "flip") == 0) cfg_flip = atoi(v);
+        else if (strcmp(line, "tag") == 0)
+        {
+            size_t k = 0;
+            for (; *v != '\0' && k < sizeof(cfg_tag) - 1; v++)
+            {
+                if ((*v >= 'a' && *v <= 'z') || (*v >= 'A' && *v <= 'Z') || (*v >= '0' && *v <= '9') || *v == '-' || *v == '_')
+                {
+                    cfg_tag[k++] = *v;
+                }
+            }
+            cfg_tag[k] = '\0';
+            SDL_snprintf(tag_sfx, sizeof(tag_sfx), "%s%s", k ? "_" : "", cfg_tag);
+        }
+        else if (strcmp(line, "preset") == 0 && strcmp(v, "hardware") == 0)
+        {
+            /* the scenes asked for in H1, unchanged from P3 */
+            SDL_strlcpy(cfg_scenes, "intro_dialogue,room_ss1,tower_climb,tower,panic_room,super_gravitron", sizeof(cfg_scenes));
+        }
+    }
+    frames = (Frame*) malloc(sizeof(Frame) * MAX_FRAMES);
+    enabled = frames != NULL;
+    if (cfg_overlay)
+    {
+        PS2Diag_SetOverlay(1);
+    }
+    result_line("# VVVVVV PS2 benchmark, build %s: settle=%d s measure=%d s over30=%d opts=0x%lx overlay=%d flip=%d\n"
+                "# times in ms; tps = logic ticks per second (full speed %.1f); tps_min = slowest 1 s window\n"
+                "# scene            tps   tps_min frame  p95    p99    max    render underruns mem_MiB\n",
+                PS2Diag_BuildId(), cfg_settle_s, cfg_measure_s, cfg_over30, (unsigned long) ps2_opts, cfg_overlay, cfg_flip,
+                1000.0 / 34);
+    PS2_Log("BENCH enabled: settle=%d measure=%d over30=%d profile=%d verify=%d opts=0x%lx flip=%d tag=%s scenes=%s",
+            cfg_settle_s, cfg_measure_s, cfg_over30, cfg_profile, cfg_verify, (unsigned long) ps2_opts, cfg_flip,
+            cfg_tag[0] ? cfg_tag : "(none)",
+            cfg_scenes[0] ? cfg_scenes : "(all)");
+}
+
+int PS2Bench_Active(void)
+{
+    return enabled;
+}
+
+int PS2Bench_LogicFrozen(void)
+{
+    return frozen;
+}
+
+int PS2Bench_WantsVerify(void)
+{
+    return want_verify || want_golden;
+}
+
+void PS2Bench_LogicBegin(void)
+{
+    logic_t0 = PS2_NowUs();
+}
+
+static int ticks_since_setup;
+
+void PS2Bench_LogicEnd(void)
+{
+    PS2Diag_Tick();
+    cur.logic_us += (uint32_t) (PS2_NowUs() - logic_t0);
+    cur.ticks++;
+    ticks_since_setup++;
+}
+
+/* Rendering draws random numbers too (flicker colours, screen shake). In
+ * bench mode every render uses its own fixed sequence and leaves the logic's
+ * rand() state untouched, so the game state after N logic ticks does not
+ * depend on how many frames were rendered, and golden frames are comparable
+ * across builds. */
+static unsigned long long logic_rand_state;
+
+void PS2Bench_RenderBegin(void)
+{
+    if (enabled)
+    {
+        logic_rand_state = _REENT_RAND_NEXT(_REENT);
+        srand(4242);
+    }
+    render_t0 = PS2_NowUs();
+    gs0 = PS2_render_stats;
+    sw0 = SW_render_stats;
+}
+
+void PS2Bench_RenderEnd(void)
+{
+    if (enabled)
+    {
+        _REENT_RAND_NEXT(_REENT) = logic_rand_state;
+    }
+    const PS2_RenderStats& g = PS2_render_stats;
+    const SW_RenderStats& s = SW_render_stats;
+    cur.render_us = (uint32_t) (PS2_NowUs() - render_t0);
+    cur.sw_us = (uint32_t) (s.queue_us - sw0.queue_us);
+    cur.gs_upload_us = (uint32_t) ((g.update_us - gs0.update_us) + (g.queue_build_us - gs0.queue_build_us));
+    cur.gs_dma_us = (uint32_t) ((g.exec_us - gs0.exec_us) + (g.finish_us - gs0.finish_us));
+    cur.vsync_us = (uint32_t) (g.vsync_us - gs0.vsync_us);
+    cur.copies = (uint32_t) ((s.cmds[CMD_COPY] - sw0.cmds[CMD_COPY]) + (s.cmds[CMD_COPY_EX] - sw0.cmds[CMD_COPY_EX]));
+    cur.fills = (uint32_t) ((s.cmds[CMD_FILL_RECTS] - sw0.cmds[CMD_FILL_RECTS]) + (s.cmds[CMD_CLEAR] - sw0.cmds[CMD_CLEAR]));
+    cur.cmds = 0;
+    for (int i = 0; i < 16; i++)
+    {
+        cur.cmds += (uint32_t) (s.cmds[i] - sw0.cmds[i]);
+    }
+}
+
+void PS2Bench_LoopBegin(uint64_t now_us)
+{
+    if (!enabled)
+    {
+        return;
+    }
+    if (loop_start_us != 0 && phase == P_MEASURE && n_frames < MAX_FRAMES)
+    {
+        cur.period_us = (uint32_t) (now_us - loop_start_us);
+#ifdef VVV_MUSIC_STREAMING
+        StreamStats ms;
+        MUSIC_GetStreamStats(&ms);
+        cur.decode_us = (uint32_t) (ms.decode_us_total - decode_total0);
+        decode_total0 = ms.decode_us_total;
+#endif
+        frames[n_frames++] = cur;
+    }
+    loop_start_us = now_us;
+    SDL_zero(cur);
+}
+
+/* ---- reporting ---- */
+static int cmp_u32(const void* a, const void* b)
+{
+    const uint32_t x = *(const uint32_t*) a, y = *(const uint32_t*) b;
+    return (x > y) - (x < y);
+}
+
+struct Dist
+{
+    double mean;
+    uint32_t p50, p95, p99, max;
+};
+
+static Dist dist(uint32_t Frame::*field, bool renders_only)
+{
+    static uint32_t tmp[MAX_FRAMES];
+    Dist d;
+    SDL_zero(d);
+    int n = 0;
+    uint64_t sum = 0;
+    for (int i = 0; i < n_frames; i++)
+    {
+        if (renders_only && frames[i].render_us == 0)
+        {
+            continue;
+        }
+        tmp[n] = frames[i].*field;
+        sum += tmp[n++];
+    }
+    if (n == 0)
+    {
+        return d;
+    }
+    qsort(tmp, n, sizeof(uint32_t), cmp_u32);
+    d.mean = (double) sum / n;
+    d.p50 = tmp[n / 2];
+    d.p95 = tmp[(n * 95) / 100];
+    d.p99 = tmp[(n * 99) / 100];
+    d.max = tmp[n - 1];
+    return d;
+}
+
+static void write_csv(const char* name)
+{
+    char path[64];
+    SDL_snprintf(path, sizeof(path), "bench_%02d_%s%s.csv", scene, name, tag_sfx);
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0)
+    {
+        return;
+    }
+    char line[160];
+    int len = SDL_snprintf(line, sizeof(line),
+                           "period_us,logic_us,ticks,render_us,sw_us,gs_upload_us,gs_dma_us,vsync_us,copies,fills,cmds,decode_us\n");
+    write(fd, line, len);
+    for (int i = 0; i < n_frames; i++)
+    {
+        const Frame& f = frames[i];
+        len = SDL_snprintf(line, sizeof(line), "%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu,%lu\n",
+                           (unsigned long) f.period_us, (unsigned long) f.logic_us, (unsigned long) f.ticks,
+                           (unsigned long) f.render_us, (unsigned long) f.sw_us, (unsigned long) f.gs_upload_us,
+                           (unsigned long) f.gs_dma_us, (unsigned long) f.vsync_us, (unsigned long) f.copies,
+                           (unsigned long) f.fills, (unsigned long) f.cmds, (unsigned long) f.decode_us);
+        write(fd, line, len);
+    }
+    close(fd);
+}
+
+static void write_profile(const char* name)
+{
+    if (prof_n == 0)
+    {
+        return;
+    }
+    char path[64];
+    SDL_snprintf(path, sizeof(path), "prof_%02d_%s%s.txt", scene, name, tag_sfx);
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0)
+    {
+        return;
+    }
+    const uint32_t n = prof_n;
+    qsort(prof_buf, n, sizeof(uint32_t), cmp_u32);
+    char line[32];
+    for (uint32_t i = 0; i < n;)
+    {
+        uint32_t j = i;
+        while (j < n && prof_buf[j] == prof_buf[i])
+        {
+            j++;
+        }
+        const int len = SDL_snprintf(line, sizeof(line), "%08lx %lu\n", (unsigned long) prof_buf[i], (unsigned long) (j - i));
+        write(fd, line, len);
+        i = j;
+    }
+    close(fd);
+}
+
+static void report(void)
+{
+    const char* name = scenes[scene].name;
+    const double secs = (measure_t1 - measure_t0) / 1e6;
+    uint32_t renders = 0, ticks = 0, multi = 0;
+    uint64_t logic = 0, sw = 0, up = 0, dma = 0, vs = 0, copies = 0, fills = 0, cmds = 0, render = 0, decode = 0;
+    uint64_t idle = 0; /* loop period not spent in logic or rendering: sleeping, vsync wait, platform hooks */
+    for (int i = 0; i < n_frames; i++)
+    {
+        const Frame& f = frames[i];
+        ticks += f.ticks;
+        multi += f.ticks >= 2;
+        logic += f.logic_us;
+        decode += f.decode_us;
+        if (f.period_us > f.logic_us + f.render_us)
+        {
+            idle += f.period_us - f.logic_us - f.render_us;
+        }
+        if (f.render_us)
+        {
+            renders++;
+            render += f.render_us;
+            sw += f.sw_us;
+            up += f.gs_upload_us;
+            dma += f.gs_dma_us;
+            vs += f.vsync_us;
+            copies += f.copies;
+            fills += f.fills;
+            cmds += f.cmds;
+        }
+    }
+    const Dist period = dist(&Frame::period_us, false);
+    /* slowest one-second window: the game's speed when it dips */
+    double tps_min = 0.0;
+    {
+        uint64_t acc = 0;
+        uint32_t win_ticks = 0;
+        for (int i = 0; i < n_frames; i++)
+        {
+            acc += frames[i].period_us;
+            win_ticks += frames[i].ticks;
+            if (acc >= 1000000)
+            {
+                const double tps = win_ticks / (acc / 1e6);
+                if (tps_min == 0.0 || tps < tps_min)
+                {
+                    tps_min = tps;
+                }
+                acc = 0;
+                win_ticks = 0;
+            }
+        }
+    }
+    const Dist rend = dist(&Frame::render_us, true);
+    const double r = renders ? renders : 1;
+    /* game draw = everything in render() that is not SDL execution, GS or vsync:
+     * VVVVVV's draw code plus SDL's command queuing */
+    const double draw = (render - sw - up - dma - vs) / r;
+    struct mallinfo mi = mallinfo();
+    PS2_Log("BENCH scene=%s frames=%d renders=%lu secs=%.1f | logic %.1f ticks/s, render %.1f fps, "
+            "multi-tick loops %lu | period mean=%.2f p50=%.2f p95=%.2f p99=%.2f max=%.2f ms | "
+            "render mean=%.2f p50=%.2f p95=%.2f p99=%.2f max=%.2f ms | per render: logic-in-loop=%.2f "
+            "draw=%.2f sw=%.2f gs_upload=%.2f gs_dma=%.2f vsync=%.2f ms | logic per tick=%.2f ms | "
+            "cmds/render=%.0f copies=%.0f fills=%.0f | music decode %.1f ms/s | idle per loop %.2f ms | malloc_in_use=%lu",
+            name, n_frames, (unsigned long) renders, secs, ticks / secs, renders / secs, (unsigned long) multi,
+            period.mean / 1000, period.p50 / 1000.0, period.p95 / 1000.0, period.p99 / 1000.0, period.max / 1000.0,
+            rend.mean / 1000, rend.p50 / 1000.0, rend.p95 / 1000.0, rend.p99 / 1000.0, rend.max / 1000.0,
+            logic / r / 1000, draw / 1000, sw / r / 1000, up / r / 1000, dma / r / 1000, vs / r / 1000,
+            ticks ? logic / (double) ticks / 1000 : 0.0, cmds / r, copies / r, fills / r, decode / secs / 1000,
+            n_frames ? idle / (double) n_frames / 1000 : 0.0, (unsigned long) mi.uordblks);
+    long scene_underruns = -1; /* -1: build without music */
+#ifdef VVV_MUSIC_STREAMING
+    {
+        StreamStats ms;
+        MUSIC_GetStreamStats(&ms);
+        scene_underruns = (long) (ms.underruns - underruns0);
+        PS2_Log("BENCH scene=%s music: song=%d active=%d underruns during scene=%lu (total %lu) opens=%lu max slice=%lu us",
+                name, music.currentsong, (int) ms.active, (unsigned long) (ms.underruns - underruns0),
+                (unsigned long) ms.underruns, (unsigned long) ms.opens, (unsigned long) ms.max_slice_us);
+    }
+#endif
+    PS2_Log("BENCH scene=%s tps min over 1 s windows: %.1f", name, tps_min);
+    result_line("%-17s %5.1f %6.1f %6.2f %6.2f %6.2f %6.2f %6.2f %6ld %7.2f\n", name, ticks / secs, tps_min,
+                period.mean / 1000, period.p95 / 1000.0, period.p99 / 1000.0, period.max / 1000.0, rend.mean / 1000,
+                scene_underruns, mi.uordblks / 1048576.0);
+    {
+        /* copies by kind during the scene, largest pixel counts first */
+        int order[24], n = 0;
+        for (int i = 0; i < 24; i++)
+        {
+            if (SW_render_stats.kinds[i].count > sw_scene0.kinds[i].count)
+            {
+                order[n++] = i;
+            }
+        }
+        for (int a = 0; a < n; a++)
+        {
+            for (int b = a + 1; b < n; b++)
+            {
+                const uint64_t pa = SW_render_stats.kinds[order[a]].pixels - sw_scene0.kinds[order[a]].pixels;
+                const uint64_t pb = SW_render_stats.kinds[order[b]].pixels - sw_scene0.kinds[order[b]].pixels;
+                if (pb > pa)
+                {
+                    const int t = order[a];
+                    order[a] = order[b];
+                    order[b] = t;
+                }
+            }
+        }
+        for (int a = 0; a < n && a < 8; a++)
+        {
+            const int i = order[a];
+            const uint64_t cnt = SW_render_stats.kinds[i].count - sw_scene0.kinds[i].count;
+            const uint64_t px = SW_render_stats.kinds[i].pixels - sw_scene0.kinds[i].pixels;
+            PS2_Log("BENCH scene=%s copies: %s -> %s blend=%lu mod=%lu: %.1f per render, %.0f px per render",
+                    name, SDL_GetPixelFormatName(SW_render_stats.kinds[i].src_format),
+                    SDL_GetPixelFormatName(SW_render_stats.kinds[i].dst_format),
+                    (unsigned long) SW_render_stats.kinds[i].blend, (unsigned long) SW_render_stats.kinds[i].mod,
+                    cnt / r, px / r);
+        }
+    }
+    /* which flipped-copy path ran during the measurement, and whether the
+     * fast path allocated anything in steady state (expected: 0) */
+    PS2_Log("BENCH scene=%s flipped copies: fast=%lu fallback=%lu scratch allocs=%lu (failed %lu) | since boot: allocs=%lu",
+            name, (unsigned long) (SDL_sw_flip_stats.fast - flip_scene0.fast),
+            (unsigned long) (SDL_sw_flip_stats.fallback - flip_scene0.fallback),
+            (unsigned long) (SDL_sw_flip_stats.scratch_allocs - flip_scene0.scratch_allocs),
+            (unsigned long) (SDL_sw_flip_stats.scratch_alloc_failures - flip_scene0.scratch_alloc_failures),
+            (unsigned long) SDL_sw_flip_stats.scratch_allocs);
+    PS2_Log("BENCH scene=%s tower/title background full redraws: %lu in %lu logic ticks", name,
+            (unsigned long) (ps2_tower_full_redraws - tower_redraws0), (unsigned long) ticks);
+    PS2_Log("BENCH scene=%s profile samples=%lu (%.0f Hz, handler calls %lu, counter %lld)", name, (unsigned long) prof_n,
+            prof_n / secs, (unsigned long) prof_calls, (long long) prof_id);
+    write_csv(name);
+    write_profile(name);
+}
+
+/* ---- A/B pixel check of one frozen frame ---- */
+static uint32_t crc32(const uint8_t* p, size_t n)
+{
+    uint32_t c = 0xffffffffu;
+    while (n--)
+    {
+        c ^= *p++;
+        for (int k = 0; k < 8; k++)
+        {
+            c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1)));
+        }
+    }
+    return ~c;
+}
+
+static void write_ppm(const char* path, const uint8_t* argb, int w, int h)
+{
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0)
+    {
+        return;
+    }
+    const char* hdr = "P6\n320 240\n255\n";
+    write(fd, hdr, strlen(hdr));
+    uint8_t* row = (uint8_t*) malloc(w * 3);
+    for (int y = 0; row && y < h; y++)
+    {
+        const uint8_t* src = argb + y * w * 4;
+        for (int x = 0; x < w; x++)
+        {
+            row[x * 3 + 0] = src[x * 4 + 2];
+            row[x * 3 + 1] = src[x * 4 + 1];
+            row[x * 3 + 2] = src[x * 4 + 0];
+        }
+        write(fd, row, w * 3);
+    }
+    free(row);
+    close(fd);
+}
+
+/* One render of the frozen golden state; logs its CRC and saves it. */
+static void golden_capture(void (*render)(void))
+{
+    SDL_Renderer* rend = gameScreen.m_renderer;
+    const int w = 320, h = 240, pitch = w * 4;
+    uint8_t* img = (uint8_t*) malloc(pitch * h);
+    want_golden = 0;
+    render();
+    if (img == NULL)
+    {
+        return;
+    }
+    /* the window as render() left it (what gets presented), then gameTexture */
+    SDL_Texture* prev = SDL_GetRenderTarget(rend);
+    SDL_SetRenderTarget(rend, NULL);
+    SDL_RenderReadPixels(rend, NULL, SDL_PIXELFORMAT_ARGB8888, img, pitch);
+    const uint32_t window_crc = crc32(img, pitch * h);
+    SDL_SetRenderTarget(rend, graphics.gameTexture);
+    SDL_RenderReadPixels(rend, NULL, SDL_PIXELFORMAT_ARGB8888, img, pitch);
+    SDL_SetRenderTarget(rend, prev);
+    PS2_Log("GOLDEN scene=%s ticks=%d crc32=%08lx window_crc32=%08lx", scenes[scene].name, ticks_since_setup,
+            (unsigned long) crc32(img, pitch * h), (unsigned long) window_crc);
+    char path[64];
+    SDL_snprintf(path, sizeof(path), "golden_%02d_%s%s.ppm", scene, scenes[scene].name, tag_sfx);
+    write_ppm(path, img, w, h);
+    free(img);
+}
+
+/* The SDL-level switches are hints; ps2_opts alone does not change them after
+ * PS2_PreInit, so the verify pass sets them too (P3.1: before this, the
+ * reference pass still used every SDL fast path). PS2_OPT_TARGET_ABGR takes
+ * effect only when the targets are created at start-up, so it cannot be
+ * compared here; golden frames across builds with opts= in bench.txt do. */
+static void apply_sdl_opts(uint32_t opts)
+{
+    SDL_SetHint("SDL_PS2_P3_FASTPATHS", (opts & PS2_OPT_SDL_FASTPATHS) ? "1" : "0");
+    SDL_SetHint("SDL_SW_FLIP_FASTPATH", (opts & PS2_OPT_FLIP_FASTPATH) ? "1" : "0");
+}
+
+void PS2Bench_Verify(void (*render)(void))
+{
+    if (want_golden)
+    {
+        golden_capture(render);
+        return;
+    }
+    SDL_Renderer* rend = gameScreen.m_renderer;
+    const uint32_t enabled_opts = ps2_opts;
+    const int w = 320, h = 240, pitch = w * 4;
+    uint8_t* img[2];
+    img[0] = (uint8_t*) malloc(pitch * h);
+    img[1] = (uint8_t*) malloc(pitch * h);
+    want_verify = 0;
+    if (img[0] == NULL || img[1] == NULL)
+    {
+        free(img[0]);
+        free(img[1]);
+        render();
+        return;
+    }
+    for (int pass = 0; pass < 2; pass++)
+    {
+        ps2_opts = pass == 0 ? 0 : enabled_opts;
+        apply_sdl_opts(ps2_opts);
+        srand(12345);
+        graphics.clear();
+        graphics.set_render_target(graphics.gameTexture);
+        render();
+        SDL_SetRenderTarget(rend, graphics.gameTexture);
+        SDL_RenderReadPixels(rend, NULL, SDL_PIXELFORMAT_ARGB8888, img[pass], pitch);
+    }
+    ps2_opts = enabled_opts;
+    apply_sdl_opts(ps2_opts);
+    uint32_t diff = 0;
+    for (int i = 0; i < w * h; i++)
+    {
+        diff += ((const uint32_t*) img[0])[i] != ((const uint32_t*) img[1])[i];
+    }
+    PS2_Log("VERIFY scene=%s opts=0x%lx: %lu of %d pixels differ between reference (SDL fast paths off) and optimised render",
+               scenes[scene].name, (unsigned long) enabled_opts, (unsigned long) diff, w * h);
+    char path[64];
+    SDL_snprintf(path, sizeof(path), "frame_%02d_%s%s.ppm", scene, scenes[scene].name, tag_sfx);
+    write_ppm(path, img[1], w, h);
+    free(img[0]);
+    free(img[1]);
+    graphics.set_render_target(graphics.gameTexture);
+}
+
+/* tag=: keep this run's log as vvvvvv_ps2<sfx>.log (the next launch truncates
+ * vvvvvv_ps2.log) */
+static void copy_log(const char* sfx)
+{
+    char path[48], buf[2048];
+    SDL_snprintf(path, sizeof(path), "vvvvvv_ps2%s.log", sfx);
+    const int in = open("vvvvvv_ps2.log", O_RDONLY);
+    const int out = in >= 0 ? open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644) : -1;
+    int n;
+    while (out >= 0 && (n = read(in, buf, sizeof(buf))) > 0)
+    {
+        if (write(out, buf, n) != n)
+        {
+            break;
+        }
+    }
+    if (out >= 0)
+    {
+        close(out);
+    }
+    if (in >= 0)
+    {
+        close(in);
+    }
+}
+
+/* ---- scene driver (between frames) ---- */
+static void enter(Phase p)
+{
+    phase = p;
+    phase_t0 = PS2_NowUs();
+    phase_loops = 0;
+}
+
+static void start_measure(void)
+{
+    n_frames = 0;
+    sw_scene0 = SW_render_stats;
+    flip_scene0 = SDL_sw_flip_stats;
+    tower_redraws0 = ps2_tower_full_redraws;
+#ifdef VVV_MUSIC_STREAMING
+    StreamStats ms;
+    MUSIC_GetStreamStats(&ms);
+    decode_total0 = ms.decode_us_total;
+    underruns0 = ms.underruns;
+#endif
+    prof_n = 0;
+    prof_on = cfg_profile;
+    PS2_LogDefer(1);
+    measure_t0 = PS2_NowUs();
+    enter(P_MEASURE);
+}
+
+void PS2Bench_LoopEnd(void)
+{
+    if (!enabled)
+    {
+        return;
+    }
+    const uint64_t now = PS2_NowUs();
+    const double t = (now - phase_t0) / 1e6;
+    phase_loops++;
+    if (ride_camera && map.towermode && !frozen)
+    {
+        const int i = obj.getplayer();
+        if (INBOUNDS_VEC(i, obj.entities))
+        {
+            obj.entities[i].yp = map.ypos + 120;
+            obj.entities[i].lerpoldyp = obj.entities[i].yp;
+        }
+    }
+    switch (phase)
+    {
+    case P_BOOT:
+        if (game.gamestate != TITLEMODE)
+        {
+            ticks_since_setup = 0;
+        }
+        else if (ticks_since_setup >= 300)
+        {
+            if (cfg_profile)
+            {
+                prof_start();
+            }
+            scene = -1;
+            pass = cfg_golden_ticks > 0 ? 0 : 1;
+            enter(P_NEXT);
+        }
+        break;
+    case P_NEXT:
+        do
+        {
+            scene++;
+        }
+        while (scene < NUM_SCENES && !scene_selected(scene));
+        if (scene >= NUM_SCENES && pass == 0)
+        {
+            pass = 1;
+            scene = -1;
+            break;
+        }
+        if (scene >= NUM_SCENES)
+        {
+            PS2_Log("BENCH done (emulated time since boot %.1f s)", now / 1e6);
+            {
+                char rpath[48], status[80];
+                SDL_snprintf(rpath, sizeof(rpath), "bench_results%s.txt", tag_sfx);
+                int fd = open(rpath, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+                if (fd >= 0)
+                {
+                    write(fd, results, results_len);
+                    close(fd);
+                }
+                PS2_Log("BENCH results:\n%s", results);
+                PS2_LogFlushNow();
+                if (cfg_tag[0] != '\0')
+                {
+                    copy_log(tag_sfx);
+                }
+                SDL_snprintf(status, sizeof(status), fd >= 0 ? "BENCH DONE: see %s" : "BENCH DONE (%s not written)", rpath);
+                PS2Diag_SetStatus(status);
+                PS2Diag_SetOverlay(1);
+            }
+            enter(P_DONE);
+            break;
+        }
+        PS2_Log("BENCH %s scene %d %s: setup (gamestate=%d)", pass == 0 ? "golden" : "measure", scene,
+                scenes[scene].name, game.gamestate);
+        srand(1);
+        ride_camera = false;
+        graphics.setflipmode = cfg_flip != 0;
+        scenes[scene].setup();
+        if (cfg_over30 >= 0)
+        {
+            game.over30mode = cfg_over30 != 0;
+        }
+        ticks_since_setup = 0;
+        enter(pass == 0 ? P_GOLDEN : P_SETTLE);
+        break;
+    case P_GOLDEN:
+        if (ticks_since_setup >= cfg_golden_ticks)
+        {
+            frozen = 1;
+            want_golden = 1;
+            enter(P_GOLDEN_CAPTURE);
+        }
+        break;
+    case P_GOLDEN_CAPTURE:
+        if (!want_golden)
+        {
+            frozen = 0;
+            enter(P_NEXT);
+        }
+        break;
+    case P_SETTLE:
+        if (t >= cfg_settle_s + scenes[scene].extra_settle_s)
+        {
+            PS2_Log("BENCH scene %d %s: measuring (gamestate=%d room=%d,%d)", scene, scenes[scene].name,
+                    game.gamestate, game.roomx, game.roomy);
+            start_measure();
+        }
+        break;
+    case P_MEASURE:
+        if (t >= cfg_measure_s)
+        {
+            prof_on = 0;
+            measure_t1 = now;
+            PS2_LogDefer(0);
+            report();
+            frozen = 1;
+            enter(P_FREEZE);
+        }
+        break;
+    case P_FREEZE:
+        if (phase_loops >= 3)
+        {
+            want_verify = cfg_verify;
+            enter(P_VERIFY);
+        }
+        break;
+    case P_VERIFY:
+        if (phase_loops >= 2)
+        {
+            PS2_Snapshot(scenes[scene].name);
+            enter(P_SNAPSHOT);
+        }
+        break;
+    case P_SNAPSHOT:
+        frozen = 0;
+        enter(P_NEXT);
+        break;
+    case P_DONE:
+        break;
+    }
+}
