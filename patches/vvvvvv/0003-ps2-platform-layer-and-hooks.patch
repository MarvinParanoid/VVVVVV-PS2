+int PS2Diag_Halted(void)
+{
+    return halted;
+}
+
+const char *PS2Diag_BuildId(void)
+{
+    return VVV_PS2_BUILD_ID;
+}
+
+void PS2Diag_Fatal(const char *what)
+{
+    char cwd[128];
+    halted = 1;
+    PS2_Log("FATAL %s | last stage: %s | last error: %s", what, last_stage, last_error[0] ? last_error : "(none)");
+    PS2_LogFlushNow();
+    if (!getcwd(cwd, sizeof(cwd)))
+    {
+        SDL_strlcpy(cwd, "?", sizeof(cwd));
+    }
+    char text[160];
+    int row = 1;
+    init_scr();
+    scr_setCursor(0);
+    screen_reset();
+    text_at(row, RED, "VVVVVV PS2: FATAL ERROR");
+    SDL_snprintf(text, sizeof(text), "build %s", VVV_PS2_BUILD_ID);
+    text_at(row + 1, WHITE, text);
+    row += 3;
+    text_at(row++, WHITE, what);
+    row++;
+    SDL_snprintf(text, sizeof(text), "last start-up stage: %s", last_stage);
+    text_at(row++, WHITE, text);
+    row++;
+    text_at(row++, WHITE, "last errors/warnings:");
+    for (int i = 0; i < 6; i++)
+    {
+        const char *e = recent[(recent_next + i) % 6];
+        if (e[0])
+        {
+            SDL_snprintf(text, sizeof(text), " %s", e);
+            text_at(row++, YELLOW, text);
+        }
+    }
+    row++;
+    SDL_snprintf(text, sizeof(text), "log file: %svvvvvv_ps2.log (if the device is writable)", cwd);
+    text_at(row++, WHITE, text);
+    row++;
+    text_at(row++, GREEN, "Please photograph this screen, then reset the console.");
+    screen_show();
+    if (!PS2_OnRealStorage())
+    {
+        save_text_screen("shot_fatal.ppm");
+    }
+    for (;;)
+    {
+        SleepThread();
+    }
+}
