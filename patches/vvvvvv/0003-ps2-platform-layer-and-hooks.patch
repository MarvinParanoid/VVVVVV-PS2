+void PS2_PreInit(int argc, char *argv[])
+{
+    char cwd[256];
+    boot_us = PS2_NowUs();
+    PS2Diag_Init();
+    if (!getcwd(cwd, sizeof(cwd)))
+        strcpy(cwd, "?");
+    on_real_storage = strncmp(cwd, "host", 4) != 0;
+    {
+        /* storage_real.txt: behave as on USB/MC/HDD (test the path in PCSX2) */
+        int fd = open("storage_real.txt", O_RDONLY);
+        if (fd >= 0)
+        {
+            close(fd);
+            on_real_storage = true;
+        }
+    }
+    if (on_real_storage)
+    {
+        int fd = open("snapshots.txt", O_RDONLY);
+        snapshots_enabled = fd >= 0;
+        if (fd >= 0)
+            close(fd);
+        start_log_writer();
+    }
+    PS2_LogNow("=== VVVVVV PS2, build %s ===", PS2Diag_BuildId());
+    PS2_LogNow("argv0=%s cwd=%s storage=%s log=%s snapshots=%s", argc > 0 ? argv[0] : "(none)", cwd,
+               on_real_storage ? "real (USB/MC/HDD)" : "host", log_writer_tid >= 0 ? "async, 10 s" : "sync, 2 s",
+               snapshots_enabled ? "on" : "off (create snapshots.txt to enable)");
+    log_memory("boot");
+
+    /* Option A render path (docs/ps2-p1-report.md, ps2-p1c-render-profile.md):
+     * SDL software renderer for render targets, 320x240 32-bit texture
+     * framebuffer scaled by the GS, small gsKit queues, batching and the
+     * bit-exact software blit fast paths. */
+    SDL_SetHint(SDL_HINT_RENDER_DRIVER, "software");
+    SDL_SetHint(SDL_HINT_RENDER_BATCHING, "1");
+    SDL_SetHint("SDL_SW_BLIT_FASTPATHS", "1");
+    SDL_SetHint(SDL_HINT_PS2_DYNAMIC_VSYNC, "1");
+    SDL_SetHint("SDL_PS2_WINDOW_PIXEL_SIZE", "320x240");
+    SDL_SetHint("SDL_PS2_PREFER_XBGR8888", "1");
+    SDL_SetHint("SDL_PS2_RENDER_QUEUE_SIZE", "65536");
+    SDL_SetHint("SDL_PS2_RENDER_PERSISTENT_QUEUE_SIZE", "16384");
+    /* FAudio mixes (and would decode music) on the SDL audio thread */
+    SDL_SetHint(SDL_HINT_THREAD_STACK_SIZE, "131072");
+    /* Existing upstream console switches (no game-code changes needed):
+     * SteamDeck -> no keyboard (hides the level editor and text entry),
+     * SteamTenfoot -> forced fullscreen. */
+    SDL_SetHint("SteamDeck", "1");
+    SDL_SetHint("SteamTenfoot", "1");
+    PS2Bench_Init();
+    PS2Diag_Stage("boot device %s, %s storage", cwd, on_real_storage ? "real" : "host");
+    {
+        /* overlay.txt: start with the diagnostics overlay on (L3+R3 toggles it) */
+        int fd = open("overlay.txt", O_RDONLY);
+        if (fd >= 0)
+        {
+            close(fd);
+            PS2Diag_SetOverlay(1);
+        }
+        /* crashtest.txt: TEST ONLY - a trap exception after ~20 s of frames
+         * to check that the exception screen appears (a trap rather than an
+         * unaligned access: PCSX2 does not raise address errors) */
+        fd = open("crashtest.txt", O_RDONLY);
+        if (fd >= 0)
+        {
+            close(fd);
+            crash_test = true;
+            PS2_LogNow("crashtest.txt present: a deliberate CPU exception will follow");
+        }
+    }
+    /* P3 optimisations; all on unless bench.txt says opts=... (A/B runs) */
+    SDL_SetHint("SDL_PS2_P3_FASTPATHS", (ps2_opts & PS2_OPT_SDL_FASTPATHS) ? "1" : "0");
+    /* P3.1: flipped copies (flip mode text and frame) without per-call surfaces */
+    SDL_SetHint("SDL_SW_FLIP_FASTPATH", (ps2_opts & PS2_OPT_FLIP_FASTPATH) ? "1" : "0");
+    PS2_LogNow("render opts=0x%lx: P3 SDL fast paths %s, flip fast path %s", (unsigned long) ps2_opts,
+               (ps2_opts & PS2_OPT_SDL_FASTPATHS) ? "on" : "off", (ps2_opts & PS2_OPT_FLIP_FASTPATH) ? "on" : "off");
+#ifdef VVV_MUSIC_STREAMING
+    {
+        int fd = open("music_soak.txt", O_RDONLY);
+        if (fd >= 0)
+        {
+            close(fd);
+            soak_enabled = true;
+            PS2_LogNow("music soak test enabled (music_soak.txt present)");
+        }
+    }
+#endif
+}
+
+/* SDL_assert in the game: log it, show it as the last error, carry on (the
+ * default handler has no UI on the PS2 and would end the program). */
+static SDL_AssertState SDLCALL assertion_handler(const SDL_AssertData *data, void *userdata)
+{
+    char text[160];
+    (void) userdata;
+    SDL_snprintf(text, sizeof(text), "assertion '%s' failed at %s:%d", data->condition, data->filename, data->linenum);
+    PS2Diag_Message('E', text);
+    return SDL_ASSERTION_IGNORE;
+}
+
+void PS2_PostInit(void)
+{
+    int i, pads = 0;
+    SDL_SetAssertionHandler(assertion_handler, NULL);
+    /* Audio thread (SDL priority 15/16) must be able to preempt the main
+     * loop, or audio starves whenever a frame does not block (P1 W2). */
+    ChangeThreadPriority(GetThreadId(), 64);
+    for (i = 0; i < SDL_NumJoysticks(); i++)
+        pads += SDL_IsGameController(i) ? 1 : 0;
+    PS2_LogNow("SDL %d.%d.%d video=%s audio=%s joysticks=%d gamecontrollers=%d",
+               SDL_MAJOR_VERSION, SDL_MINOR_VERSION, SDL_PATCHLEVEL,
+               SDL_GetCurrentVideoDriver() ? SDL_GetCurrentVideoDriver() : "-",
+               SDL_GetCurrentAudioDriver() ? SDL_GetCurrentAudioDriver() : "-",
+               SDL_NumJoysticks(), pads);
+#ifdef VVV_PS2_NO_MUSIC
+    PS2_LogNow("music: disabled at build time (VVV_PS2_NO_MUSIC); sound effects enabled");
+#endif
+    log_memory("after SDL_Init");
+    PS2Diag_Stage("SDL started: video %s, audio %s, %d controller(s)",
+                  SDL_WasInit(SDL_INIT_VIDEO) ? (SDL_GetCurrentVideoDriver() ? SDL_GetCurrentVideoDriver() : "?") : "FAILED",
+                  SDL_WasInit(SDL_INIT_AUDIO) ? (SDL_GetCurrentAudioDriver() ? SDL_GetCurrentAudioDriver() : "?") : "FAILED",
+                  pads);
+    if (!SDL_WasInit(SDL_INIT_VIDEO) || !SDL_WasInit(SDL_INIT_AUDIO))
+        PS2Diag_Message('E', SDL_GetError());
+}
+
+void PS2_LogAssetLoad(const char *name, size_t bytes, uint64_t us)
+{
+    PS2_Log("ASSET %-40s %8lu B %7lu us", name, (unsigned long) bytes, (unsigned long) us);
+}
+
+void PS2_RenderBegin(void)
+{
+    render_t0 = PS2_NowUs();
+    PS2Bench_RenderBegin();
+}
+
+void PS2_RenderEnd(void)
+{
+    uint32_t dt = (uint32_t) (PS2_NowUs() - render_t0);
+    if (n_renders < PS2_REPORT_FRAMES)
+        render_samples[n_renders] = dt;
+    n_renders++;
+    sum_render += dt;
+    if (dt > max_render)
+        max_render = dt;
+    render_since_loop += dt;
+    PS2Bench_RenderEnd();
+    if (!first_present_us)
+    {
+        first_present_us = PS2_NowUs();
+        PS2_LogNow("MILESTONE first frame presented at %.2f s after boot (render %lu us)",
+                   (first_present_us - boot_us) / 1e6, (unsigned long) dt);
+        log_memory("first frame");
+        snapshot_due_loop = n_loops + 60;
+        snapshot_due_tag = "boot";
+    }
+}
+
+#ifdef VVV_MUSIC_STREAMING
+/* ---- Music soak test (enabled only if music_soak.txt is next to the ELF) ----
+ * Drives the real music API (play() with its fade-in, pause/resume, sound
+ * effects on top; niceplay() is not used because it only takes effect once
+ * the game has started music, i.e. never on the title screen) on a fixed schedule, starting once
+ * GAMEMODE is reached (or after 60 s), so long PCSX2 runs exercise every
+ * track, track switches, loop boundaries and SFX mixing deterministically. */
+static uint64_t soak_t0;
+static int soak_last_song = -2, soak_last_sfx = -1, soak_paused_at = -1, soak_resumed_at = -1;
+
+static void music_soak_step(void)
+{
+    const uint64_t now = PS2_NowUs();
+    double t;
+    int song, sfx_slot, minute;
+
+    if (!soak_enabled)
+        return;
+    if (soak_t0 == 0)
+    {
+        if (game.gamestate != GAMEMODE && now - boot_us < 60000000ULL)
+            return;
+        soak_t0 = now;
+        PS2_LogNow("SOAK start (gamestate=%d): 16 songs x 20 s, then song 10 (6:09) for 420 s, then song 1 (3:39) "
+                   "for 240 s; pause/resume every 60 s; an SFX every 5 s", game.gamestate);
+    }
+    t = (now - soak_t0) / 1e6;
+    if (t < 320.0)
+        song = (int) (t / 20.0);           /* every song incl. the non-looping jingles 0 and 7 */
+    else if (t < 740.0)
+        song = 10;                          /* longest track: reaches its loop point at 369 s */
+    else if (t < 980.0)
+        song = 1;
+    else
+        song = 4;
+    if (song != soak_last_song && song != music.currentsong)
+    {
+        PS2_Log("SOAK t=%.1f s play(%d) (was %d)", t, song, music.currentsong);
+        music.play(song);
+    }
+    soak_last_song = song;
+
+    /* pause for 3 s at the start of every minute (after the first) */
+    minute = (int) (t / 60.0);
+    if (minute > 0 && soak_paused_at != minute && t - minute * 60.0 < 1.0)
+    {
+        soak_paused_at = minute;
+        PS2_Log("SOAK t=%.1f s pause", t);
+        music.pause();
+    }
+    if (soak_paused_at == minute && soak_resumed_at != minute && t - minute * 60.0 >= 3.0)
+    {
+        soak_resumed_at = minute;
+        PS2_Log("SOAK t=%.1f s resume", t);
+        music.resume();
+    }
+
+    sfx_slot = (int) (t / 5.0);
+    if (sfx_slot != soak_last_sfx)
+    {
+        soak_last_sfx = sfx_slot;
+        music.playef(sfx_slot % 28);
+    }
+}
+#endif
+
+void PS2_LoopBegin(void)
+{
+    uint64_t now = PS2_NowUs();
+    while (PS2Diag_Halted())
+    {
+        /* an exception/fatal screen is up (possibly reported from another
+         * thread): stop rendering so it stays visible */
+        SleepThread();
+    }
+    if (loop_prev_start)
+    {
+        uint32_t period = (uint32_t) (now - loop_prev_start);
+        PS2Diag_Frame(period, render_since_loop);
+        sum_period += period;
+        if (period > max_period)
+            max_period = period;
+    }
+    loop_prev_start = now;
+    loop_t0 = now;
+    render_since_loop = 0;
+    PS2Bench_LoopBegin(now);
+}
+
+static int cmp_u32(const void *a, const void *b)
+{
+    uint32_t x = *(const uint32_t *) a, y = *(const uint32_t *) b;
+    return (x > y) - (x < y);
+}
+
+void PS2_LoopEnd(void)
+{
+    uint32_t work = (uint32_t) (PS2_NowUs() - loop_t0);
+    sum_work += work;
+    if (work > max_work)
+        max_work = work;
+    n_loops++;
+    if (crash_test && n_loops == 600)
+    {
+        PS2_LogFlushNow();
+        __asm__ volatile("teq $0, $0"); /* trap exception (code 13) */
+    }
+#ifdef VVV_MUSIC_STREAMING
+    music_soak_step();
+#endif
+    PS2Bench_LoopEnd();
+
+#ifdef VVV_MUSIC_STREAMING
+    {
+        static Uint32 seen_opens;
+        StreamStats ms;
+        MUSIC_GetStreamStats(&ms);
+        if (ms.opens != seen_opens)
+        {
+            seen_opens = ms.opens;
+            PS2_Log("MUSIC opened source %d for song %d in %lu us (t=%.2f s) underruns so far %lu",
+                    ms.last_source, music.currentsong, (unsigned long) ms.last_open_us,
+                    (PS2_NowUs() - boot_us) / 1e6, (unsigned long) ms.underruns);
+        }
+    }
+#endif
+
+    /* gamestate / room transitions: evidence of reaching playable rooms */
+    if (game.gamestate != last_gamestate || game.roomx != last_rx || game.roomy != last_ry)
+    {
+        PS2_Log("STATE gamestate=%d room=(%d,%d) t=%.2f s", game.gamestate, game.roomx, game.roomy,
+                (PS2_NowUs() - boot_us) / 1e6);
+        if (game.gamestate == GAMEMODE && last_gamestate != GAMEMODE && !PS2Bench_Active())
+        {
+            log_memory("entered GAMEMODE");
+            snapshot_due_loop = n_loops + 90;
+            snapshot_due_tag = "gamemode";
+        }
+        last_gamestate = game.gamestate;
+        last_rx = game.roomx;
+        last_ry = game.roomy;
+    }
+
+    if (snapshot_due_tag && n_loops >= snapshot_due_loop)
+    {
+        PS2_Snapshot(snapshot_due_tag);
+        snapshot_due_tag = NULL;
+    }
+    else if (n_loops % 1800 == 0 && !PS2Bench_Active())
+    {
+        PS2_Snapshot("periodic");
+    }
+
+    if (n_loops % PS2_REPORT_FRAMES == 0)
+    {
+        uint32_t p95 = 0, p50 = 0;
+        int n = n_renders < PS2_REPORT_FRAMES ? (int) n_renders : PS2_REPORT_FRAMES;
+        if (n > 0)
+        {
+            qsort(render_samples, n, sizeof(uint32_t), cmp_u32);
+            p50 = render_samples[n / 2];
+            p95 = render_samples[(n * 95) / 100];
+        }
+        PS2_Log("FRAME loops=%d period mean=%lu max=%lu us | work(logic+render) mean=%lu max=%lu us | "
+                "render mean=%lu p50=%lu p95=%lu max=%lu us (%d renders) | gamestate=%d room=(%d,%d)",
+                PS2_REPORT_FRAMES,
+                (unsigned long) (sum_period / PS2_REPORT_FRAMES), (unsigned long) max_period,
+                (unsigned long) (sum_work / PS2_REPORT_FRAMES), (unsigned long) max_work,
+                (unsigned long) (n ? sum_render / n_renders : 0), (unsigned long) p50, (unsigned long) p95,
+                (unsigned long) max_render, (int) n_renders, game.gamestate, game.roomx, game.roomy);
+        log_memory("periodic");
+#ifdef VVV_MUSIC_STREAMING
+        {
+            StreamStats ms;
+            MUSIC_GetStreamStats(&ms);
+            PS2_Log("MUSIC active=%d song=%d opens=%lu (fail %lu) open last=%lu max=%lu us | decode calls=%lu "
+                    "avg=%lu max=%lu us | underruns=%lu (%lu frames) priming=%lu yields=%lu max slice=%lu us (phase %d) | ring %lu B, "
+                    "fill now=%lu min=%lu frames | loops=%lu loop seek max=%lu us fill at loop=%lu",
+                    (int) ms.active, music.currentsong, (unsigned long) ms.opens, (unsigned long) ms.open_failures,
+                    (unsigned long) ms.last_open_us, (unsigned long) ms.max_open_us, (unsigned long) ms.decode_calls,
+                    (unsigned long) (ms.decode_calls ? ms.decode_us_total / ms.decode_calls : 0),
+                    (unsigned long) ms.max_decode_us, (unsigned long) ms.underruns,
+                    (unsigned long) ms.underrun_frames, (unsigned long) ms.priming_buffers,
+                    (unsigned long) ms.yields, (unsigned long) ms.max_slice_us, ms.max_slice_phase, (unsigned long) ms.ring_bytes, (unsigned long) ms.ring_fill_frames,
+                    (unsigned long) ms.min_fill_frames, (unsigned long) ms.loops,
+                    (unsigned long) ms.max_loop_seek_us, (unsigned long) ms.loop_fill_frames);
+            MUSIC_ResetStreamMinFill();
+        }
+#endif
+        sum_period = sum_work = sum_render = 0;
+        max_period = max_work = max_render = 0;
+        n_renders = 0;
+    }
+}
--- a/desktop_version/src/PS2Bench.h
