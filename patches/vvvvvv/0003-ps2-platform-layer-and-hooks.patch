+void PS2Diag_Init(void)
+{
+    console_open();
+    {
+        int fd = open("bootshot.txt", O_RDONLY);
+        bootshot = fd >= 0;
+        if (fd >= 0)
+        {
+            close(fd);
+        }
+    }
+    if (early_len > 0)
+    {
+        PS2_Log("BOOT (before the log existed):\n%s", early);
+    }
+    install_exception_screen();
+}
+
+void PS2Diag_Stage(const char *fmt, ...)
+{
+    char text[sizeof(last_stage)];
+    va_list ap;
+    va_start(ap, fmt);
+    SDL_vsnprintf(text, sizeof(text), fmt, ap);
+    va_end(ap);
+    SDL_strlcpy(last_stage, text, sizeof(last_stage));
+    PS2_Log("STAGE %s", text);
+    console_line(WHITE, text);
+    if (bootshot && console_active && !PS2_OnRealStorage() && strncmp(text, "settings loaded", 15) == 0)
+    {
+        save_text_screen("shot_boot_console.ppm");
+    }
+}
+
+void PS2Diag_RendererReady(void)
+{
+    console_active = false;
+    renderer_ready = true;
+}
+
+void PS2Diag_Message(char level, const char *text)
+{
+    /* PCSX2's host: refuses PhysFS a look outside the ELF folder at start-up
+     * (known since P2a, harmless); not worth showing as the last error */
+    if (level == 'E' && !PS2_OnRealStorage() && strncmp(text, "Could not stat file", 19) == 0)
+    {
+        PS2_Log("WARN (host: only, harmless) %s", text);
+        return;
+    }
+    PS2_Log("%s %s", level == 'E' ? "ERROR" : level == 'W' ? "WARN" : "INFO", text);
+    if (level == 'E' || level == 'W')
+    {
+        SDL_strlcpy(last_error, text, sizeof(last_error));
+        SDL_strlcpy(recent[recent_next], text, sizeof(recent[0]));
+        recent_next = (recent_next + 1) % 6;
+        console_line(level == 'E' ? RED : YELLOW, text);
+    }
+}
+
+const char *PS2Diag_LastError(void)
+{
+    return last_error;
+}
+
+/* PCSX2/host: only: save the text screen (libdebug: 640x448, PSMCT32 at
+ * VRAM 0) so automated tests can see it; on real storage this is skipped. */
+static void save_text_screen(const char *name)
+{
+    const int w = 640, h = 448;
+    SDL_Delay(300); /* let libdebug's last text DMA reach VRAM */
+    uint8_t *buf = (uint8_t *) memalign(64, w * h * 4);
+    if (buf == NULL)
+    {
+        return;
+    }
+    /* in bands: in PCSX2 a single whole-screen CT32 read returned only the
+     * top 40 lines (the rest came back black) */
+    for (int y = 0; y < h; y += 32)
+    {
+        ps2_screenshot(buf + y * w * 4, 0, 0, y, w, 32, 0 /* CT32 */);
+    }
+    int fd = open(name, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd >= 0)
+    {
+        static uint8_t row[640 * 3];
+        const char *hdr = "P6\n640 448\n255\n";
+        write(fd, hdr, strlen(hdr));
+        for (int y = 0; y < h; y++)
+        {
+            for (int x = 0; x < w; x++)
+            {
+                memcpy(row + x * 3, buf + (y * w + x) * 4, 3);
+            }
+            write(fd, row, sizeof(row));
+        }
+        close(fd);
+    }
+    free(buf);
+}
