+    while (len > 1 && tmp[len - 1] == '/' && tmp[len - 2] != ':')
+    {
+        tmp[--len] = '\0';
+    }
+    result = mkdir(tmp, mode);
+    if (result != 0 && errno != EEXIST)
+    {
