+/* Log file next to the ELF. The whole buffer is rewritten (O_TRUNC) when
+ * flushed: append/seek on host: and some devices is unreliable, and logs are
+ * small. Flushed on notable events and at most every 2 s otherwise. */
+#define PS2_LOG_SIZE (96 * 1024)
+static char log_buf[PS2_LOG_SIZE];
+static size_t log_len;
+static uint64_t log_last_flush;
+static int log_deferred; /* no file writes while a benchmark is measuring */
+/* Running from real storage (mass:, mc:, hdd...) rather than PCSX2/ps2link
+ * host:. There a 96 KB rewrite takes a noticeable time (USB 1.1), so the log
+ * is written by a background thread, at most every 10 s or on milestones,
+ * and periodic GS snapshots (900 KB each) are off unless snapshots.txt
+ * exists. See docs/ps2-p3-report.md, hardware readiness. */
+static bool on_real_storage;
+static bool snapshots_enabled = true;
+static bool crash_test;
+static uint32_t render_since_loop; /* render time inside the current loop */
+static char log_copy[PS2_LOG_SIZE];
+static size_t log_copy_len;
+static int log_writer_sema = -1;
+static volatile bool log_writer_busy;
+static int log_writer_tid = -1;
+static const char *const log_path = "vvvvvv_ps2.log";
+
+/* Frame statistics, reported every PS2_REPORT_FRAMES loop iterations. */
+#define PS2_REPORT_FRAMES 300
+static uint64_t loop_t0, loop_prev_start, render_t0;
+static uint32_t n_loops, n_renders;
+static uint64_t sum_period, sum_work, sum_render;
+static uint32_t max_period, max_work, max_render;
+static uint32_t render_samples[PS2_REPORT_FRAMES];
+static int last_gamestate = -1, last_rx = -1, last_ry = -1;
+static uint64_t first_present_us;
+static bool soak_enabled; /* music soak test, see music_soak_step() */
+static uint64_t boot_us;
+
+uint64_t PS2_NowUs(void)
+{
+    /* BUSCLK ticks -> microseconds; kBUSCLK = 147456000 */
+    return GetTimerSystemTime() * 1000ULL / (kBUSCLK / 1000ULL);
+}
+
+static void log_write_file(const char *buf, size_t len)
+{
+    int fd = open(log_path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd >= 0)
+    {
+        write(fd, buf, len);
+        close(fd);
+    }
+}
+
+static void log_writer_thread(void *arg)
+{
+    (void) arg;
+    for (;;)
+    {
+        WaitSema(log_writer_sema);
+        log_write_file(log_copy, log_copy_len);
+        log_writer_busy = false;
+    }
+}
+
+static void log_flush(void)
+{
+    log_last_flush = PS2_NowUs();
+    if (log_writer_tid >= 0)
+    {
+        if (log_writer_busy)
+            return; /* the next flush writes the newer buffer */
+        memcpy(log_copy, log_buf, log_len);
+        log_copy_len = log_len;
+        log_writer_busy = true;
+        SignalSema(log_writer_sema);
+        return;
+    }
+    log_write_file(log_buf, log_len);
+}
+
+static void start_log_writer(void)
+{
+    static uint8_t stack[16 * 1024] __attribute__((aligned(16)));
+    ee_sema_t sema;
+    ee_thread_t thread;
+    sema.init_count = 0;
+    sema.max_count = 1;
+    sema.option = 0;
+    log_writer_sema = CreateSema(&sema);
+    if (log_writer_sema < 0)
+        return;
+    memset(&thread, 0, sizeof(thread));
+    thread.func = (void *) log_writer_thread;
+    thread.stack = stack;
+    thread.stack_size = sizeof(stack);
+    thread.gp_reg = &_gp;
+    thread.initial_priority = 50; /* above the game thread; it mostly waits on the IOP */
+    log_writer_tid = CreateThread(&thread);
+    if (log_writer_tid >= 0)
+        StartThread(log_writer_tid, NULL);
+}
+
+/* PS2_Log is used from several threads (game, music streaming via vlog_*),
+ * so appending to log_buf is serialised. The semaphore is created by the
+ * first call, which happens before any other thread exists. */
+static int log_lock = -1;
+
+static void log_lock_take(void)
+{
+    if (log_lock < 0)
+    {
+        ee_sema_t sema;
+        sema.init_count = 1;
+        sema.max_count = 1;
+        sema.option = 0;
+        log_lock = CreateSema(&sema);
+    }
+    if (log_lock >= 0)
+        WaitSema(log_lock);
+}
+
+static void log_lock_give(void)
+{
+    if (log_lock >= 0)
+        SignalSema(log_lock);
+}
+
+static void log_vline(const char *fmt, va_list ap, int flush)
+{
+    char line[512];
+    int n = SDL_vsnprintf(line, sizeof(line) - 1, fmt, ap);
+    if (n < 0)
+        return;
+    if (n > (int) sizeof(line) - 2)
+        n = (int) sizeof(line) - 2;
+    line[n++] = '\n';
+    line[n] = '\0';
+    printf("[ps2] %s", line);
+    log_lock_take();
+    if (log_len + n > PS2_LOG_SIZE)
+    {
+        /* keep the head (boot info) and the newest tail */
+        size_t keep_head = PS2_LOG_SIZE / 4;
+        size_t drop = log_len + n - PS2_LOG_SIZE + 4096;
+        memmove(log_buf + keep_head, log_buf + keep_head + drop, log_len - keep_head - drop);
+        log_len -= drop;
+    }
+    memcpy(log_buf + log_len, line, n);
+    log_len += n;
+    if (!log_deferred && (flush || PS2_NowUs() - log_last_flush > (on_real_storage ? 10000000u : 2000000u)))
+        log_flush();
+    log_lock_give();
+}
+
+void PS2_Log(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    log_vline(fmt, ap, 0);
+    va_end(ap);
+}
+
+int PS2_OnRealStorage(void)
+{
+    return on_real_storage;
+}
+
+void PS2_LogFlushNow(void)
+{
+    if (log_writer_tid >= 0)
+    {
+        while (log_writer_busy)
+            SDL_Delay(1);
+    }
+    log_lock_take();
+    log_write_file(log_buf, log_len);
+    log_lock_give();
+}
+
+void PS2_LogDefer(int defer)
+{
+    log_lock_take();
+    log_deferred = defer;
+    if (!defer)
+        log_flush();
+    log_lock_give();
+}
+
+static void PS2_LogNow(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    log_vline(fmt, ap, 1);
+    va_end(ap);
+}
+
+extern char end[];
+extern void *_gp;
+
+/* ---- GS framebuffer snapshots (evidence of what is on screen) ----
+ * Reads GS buffer 0 (640x448 CT24, allocated first by SDL's gsKit renderer)
+ * and writes a binary PPM next to the ELF. Same method as the P1 tests
+ * (tests/ps2/common/gsread.c), including re-arming GS FINISH afterwards. */
+#define GS_W 640
+#define GS_H 448
+static int snapshot_count;
+
+static void rearm_gs_finish(void)
+{
+    static u64 packet[4] __attribute__((aligned(16)));
+    packet[0] = GIF_TAG(1, 1, 0, 0, 0, 1);
+    packet[1] = GIF_AD;
+    packet[2] = 0;
+    packet[3] = GS_FINISH;
+    FlushCache(0);
+    dmaKit_send(DMA_CHANNEL_GIF, packet, 2);
+    dmaKit_wait_fast();
+    while (!(GS_CSR_FINISH))
+        ;
+}
+
+static void snapshot(const char *tag)
+{
+    char name[64], header[32];
+    uint8_t *buf = (uint8_t *) memalign(64, GS_W * GS_H * 3);
+    uint64_t t0 = PS2_NowUs();
+    int fd, hl;
+    if (!buf)
+        return;
+    if (ps2_screenshot(buf, 0, 0, 0, GS_W, GS_H, 1 /* CT24 */) != 1)
+    {
+        free(buf);
+        return;
+    }
+    FlushCache(0);
+    rearm_gs_finish();
+    SDL_snprintf(name, sizeof(name), "shot_%02d_%s.ppm", snapshot_count++, tag);
+    hl = SDL_snprintf(header, sizeof(header), "P6\n%d %d\n255\n", GS_W, GS_H);
+    fd = open(name, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd >= 0)
+    {
+        write(fd, header, hl);
+        write(fd, buf, GS_W * GS_H * 3);
+        close(fd);
+    }
+    free(buf);
+    PS2_Log("SNAPSHOT %s (%lu us)", name, (unsigned long) (PS2_NowUs() - t0));
+}
+void PS2_Snapshot(const char *tag)
+{
+    if (snapshots_enabled)
+        snapshot(tag);
+}
+
+static uint32_t snapshot_due_loop;
+static const char *snapshot_due_tag;
+
+static void log_memory(const char *label)
+{
+    struct mallinfo mi = mallinfo();
+    char *brk = (char *) sbrk(0);
+    char *heap_end = (char *) EndOfHeap();
+    PS2_LogNow("MEM %-20s malloc_in_use=%lu arena=%lu headroom=%lu (EndOfHeap-brk %lu + free %lu) elf_end=%p",
+               label, (unsigned long) mi.uordblks, (unsigned long) mi.arena,
+               (unsigned long) (heap_end - brk) + (unsigned long) mi.fordblks,
+               (unsigned long) (heap_end - brk), (unsigned long) mi.fordblks, (void *) end);
+}
