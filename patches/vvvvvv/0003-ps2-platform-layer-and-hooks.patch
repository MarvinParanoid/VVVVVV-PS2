+/* ---- overlay ---- */
+static int overlay_on;
+static bool overlay_dirty;
+static SDL_Texture *overlay_tex;
+static char lines[3][48];
+static uint8_t line_rgb[3][3];
+static uint32_t win_ticks, win_loops, win_renders;
+static uint64_t win_period, win_render, win_t0;
+#ifdef VVV_MUSIC_STREAMING
+static uint64_t win_decode0;
+#endif
+static char status_text[48];
+static SDL_GameController *pad;
+static bool combo_was_down;
+
+#define OVERLAY_Y 16 /* below the top overscan of a CRT */
+#define OVERLAY_H 32
+
+void PS2Diag_Tick(void)
+{
+    win_ticks++;
+}
+
+void PS2Diag_Frame(uint32_t period_us, uint32_t render_us)
+{
+    win_loops++;
+    win_period += period_us;
+    if (render_us)
+    {
+        win_renders++;
+        win_render += render_us;
+    }
+}
+
+void PS2Diag_SetStatus(const char *text)
+{
+    SDL_strlcpy(status_text, text, sizeof(status_text));
+}
+
+void PS2Diag_SetOverlay(int on)
+{
+    overlay_on = on;
+    win_t0 = 0;
+}
+
+int PS2Diag_OverlayOn(void)
+{
+    return overlay_on;
+}
+
+static void set_line(int i, uint8_t r, uint8_t g, uint8_t b, const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    SDL_vsnprintf(lines[i], sizeof(lines[i]), fmt, ap);
+    va_end(ap);
+    line_rgb[i][0] = r;
+    line_rgb[i][1] = g;
+    line_rgb[i][2] = b;
+}
+
+/* once a second: turn the window's counters into three short text lines */
+static void update_text(uint64_t now)
+{
+    const double secs = (now - win_t0) / 1e6;
+    const double tps = win_ticks / secs, target = 1000.0 / game.get_timestep();
+    const double frame = win_loops ? win_period / (double) win_loops / 1000.0 : 0.0;
+    const double render = win_renders ? win_render / (double) win_renders / 1000.0 : 0.0;
+    struct mallinfo mi = mallinfo();
+    const double free_mb = ((char *) EndOfHeap() - (char *) sbrk(0) + (double) mi.fordblks) / 1048576.0;
+    const bool slow = tps < target - 0.5;
+
+    set_line(0, 255, slow ? 128 : 255, slow ? 128 : 255, "TPS %4.1f/%4.1f FRAME %4.1fms RND %4.1fms",
+             tps, target, frame, render);
+#ifdef VVV_MUSIC_STREAMING
+    StreamStats ms;
+    MUSIC_GetStreamStats(&ms);
+    const double decode = (ms.decode_us_total - win_decode0) / secs / 1000.0;
+    win_decode0 = ms.decode_us_total;
+    set_line(1, 255, ms.underruns ? 128 : 255, ms.underruns ? 128 : 255, "MUSIC %s %3.0fms/s UNDERRUN %lu FREE %3.1fM",
+             ms.active ? "on " : "off", decode, (unsigned long) ms.underruns, free_mb);
+#else
+    set_line(1, 255, 255, 255, "MUSIC off (build)  FREE %3.1fM", free_mb);
+#endif
+    if (last_error[0])
+    {
+        set_line(2, 255, 200, 64, "ERR %.34s", last_error);
+    }
+    else
+    {
+        set_line(2, 128, 255, 128, "%s", status_text[0] ? status_text : "STATUS OK  " VVV_PS2_BUILD_ID "  L3+R3 hides");
+    }
+    win_ticks = win_loops = win_renders = 0;
+    win_period = win_render = 0;
+    win_t0 = now;
+    overlay_dirty = true;
+}
+
+static void poll_combo(void)
+{
+    static uint32_t refresh;
+    if (pad == NULL || (++refresh % 64) == 0)
+    {
+        pad = NULL;
+        for (int i = 0; i < SDL_NumJoysticks() && pad == NULL; i++)
+        {
+            if (SDL_IsGameController(i))
+            {
+                pad = SDL_GameControllerFromInstanceID(SDL_JoystickGetDeviceInstanceID(i));
+            }
+        }
+    }
+    if (pad == NULL)
+    {
+        return;
+    }
+    /* both stick clicks: VVVVVV binds neither by default */
+    const bool down = SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_LEFTSTICK) &&
+                      SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_RIGHTSTICK);
+    if (down && !combo_was_down)
+    {
+        PS2Diag_SetOverlay(!overlay_on);
+        PS2_Log("OVERLAY %s (L3+R3)", overlay_on ? "on" : "off");
+    }
+    combo_was_down = down;
+}
+
+void PS2Diag_DrawOverlay(void)
+{
+    SDL_Renderer *rend = gameScreen.m_renderer;
+    poll_combo();
+    if (!overlay_on || rend == NULL)
+    {
+        return;
+    }
+    const uint64_t now = PS2_NowUs();
+    if (win_t0 == 0)
+    {
+        win_t0 = now;
+        win_ticks = win_loops = win_renders = 0;
+        win_period = win_render = 0;
+        set_line(0, 255, 255, 255, "diagnostics: first values in 1 s");
+        lines[1][0] = lines[2][0] = '\0';
+        overlay_dirty = true;
+    }
+    else if (now - win_t0 >= 1000000)
+    {
+        update_text(now);
+    }
+
+    SDL_Texture *target = SDL_GetRenderTarget(rend);
+    if (overlay_tex == NULL)
+    {
+        overlay_tex = SDL_CreateTexture(rend, VVV_TARGET_PIXELFORMAT, SDL_TEXTUREACCESS_TARGET, 320, OVERLAY_H);
+        if (overlay_tex == NULL)
+        {
+            overlay_on = 0;
+            return;
+        }
+        SDL_SetTextureBlendMode(overlay_tex, SDL_BLENDMODE_NONE);
+    }
+    if (overlay_dirty)
+    {
+        /* text is drawn only when it changes: about 3 x 40 glyphs a second */
+        graphics.set_render_target(overlay_tex);
+        graphics.clear(0, 0, 0, 255);
+        for (int i = 0; i < 3; i++)
+        {
+            font::print(0, 4, 1 + i * 10, lines[i], line_rgb[i][0], line_rgb[i][1], line_rgb[i][2]);
+        }
+        overlay_dirty = false;
+    }
+    /* per frame: one unblended 320x32 copy onto the finished window */
+    graphics.set_render_target(NULL);
+    const SDL_Rect dst = {0, OVERLAY_Y, 320, OVERLAY_H};
+    SDL_RenderCopy(rend, overlay_tex, NULL, &dst);
+    graphics.set_render_target(target);
+}
