+/* Called by SDL's PS2 main() (weak there) before SDL_main: IOP reset, driver
+ * loading, waiting for the boot device. No files can be written yet. */
+extern "C" void SDL_PS2_BootMessage(const char *message)
+{
+    console_open();
+    console_line(GREY, message);
+    SDL_strlcpy(last_stage, message, sizeof(last_stage));
+    const size_t n = strlen(message);
+    if (early_len + n + 2 < sizeof(early))
+    {
+        memcpy(early + early_len, message, n);
+        early_len += n;
+        early[early_len++] = '\n';
+        early[early_len] = '\0';
+    }
+}
+
+/* ---- CPU exceptions: a register screen instead of a silent hang ---- */
+static const char *exception_name(unsigned code)
+{
+    switch (code)
+    {
+    case 1: return "TLB modification";
+    case 2: return "TLB miss (load)";
+    case 3: return "TLB miss (store)";
+    case 4: return "address error (load/fetch)";
+    case 5: return "address error (store)";
+    case 6: return "bus error (fetch)";
+    case 7: return "bus error (data)";
+    case 10: return "reserved instruction";
+    case 12: return "arithmetic overflow";
+    case 13: return "trap";
+    default: return "exception";
+    }
+}
+
+/* The handler runs in exception context, where the kernel calls libdebug
+ * needs (SetGsCrt, FlushCache) are not allowed: it only saves the registers
+ * and resumes the faulting thread in exception_report(). */
+static EE_RegFrame saved_frame;
+static void save_text_screen(const char *name);
+
+static void exception_report(void)
+{
+    const EE_RegFrame *frame = &saved_frame;
+    halted = 1; /* the main loop stops at its next iteration, so it cannot draw over this */
+    const unsigned code = (frame->cause >> 2) & 31;
+    char text[96];
+    SDL_snprintf(text, sizeof(text), "VVVVVV PS2 exception screen: code %u EPC %08x BadVAddr %08x RA %08x",
+                 code, (unsigned) frame->epc, (unsigned) frame->badvaddr, (unsigned) frame->ra[0]);
+    sio_puts(text); /* EE serial console; PCSX2 shows it in its log */
+    init_scr();
+    scr_setCursor(0);
+    screen_reset();
+    SDL_snprintf(text, sizeof(text), "VVVVVV PS2: CPU EXCEPTION - %s (code %u)", exception_name(code), code);
+    text_at(1, RED, text);
+    SDL_snprintf(text, sizeof(text), "build %s, thread %d", VVV_PS2_BUILD_ID, GetThreadId());
+    text_at(2, WHITE, text);
+    SDL_snprintf(text, sizeof(text), "EPC      %08x   BadVAddr %08x", (unsigned) frame->epc, (unsigned) frame->badvaddr);
+    text_at(3, WHITE, text);
+    SDL_snprintf(text, sizeof(text), "RA       %08x   SP       %08x", (unsigned) frame->ra[0], (unsigned) frame->sp[0]);
+    text_at(4, WHITE, text);
+    SDL_snprintf(text, sizeof(text), "Cause    %08x   Status   %08x", (unsigned) frame->cause, (unsigned) frame->status);
+    text_at(5, WHITE, text);
+    SDL_snprintf(text, sizeof(text), "last start-up stage: %s", last_stage);
+    text_at(7, WHITE, text);
+    SDL_snprintf(text, sizeof(text), "last error: %s", last_error[0] ? last_error : "(none)");
+    text_at(8, WHITE, text);
+    text_at(10, YELLOW, "Please photograph this screen, then reset the console.");
+    text_at(11, YELLOW, "(EPC/RA can be looked up in the unstripped VVVVVV.elf)");
+    screen_show();
+    PS2_Log("EXCEPTION %s code %u EPC %08x BadVAddr %08x RA %08x", exception_name(code), code,
+            (unsigned) frame->epc, (unsigned) frame->badvaddr, (unsigned) frame->ra[0]);
+    if (!PS2_OnRealStorage())
+    {
+        save_text_screen("shot_exception.ppm");
+    }
+    PS2_LogFlushNow();
+    for (;;)
+    {
+        SleepThread();
+    }
+}
+
+static int exception_screen(EE_RegFrame *frame)
+{
+    static int entered;
+    if (entered++)
+    {
+        /* a second fault (e.g. while reporting the first): keep the first
+         * report; park this thread where it faulted */
+        for (;;)
+        {
+        }
+    }
+    memcpy(&saved_frame, frame, sizeof(saved_frame));
+    frame->epc = (u32) (uintptr_t) exception_report;
+    return 1;
+}
+
+static void install_exception_screen(void)
+{
+    static const int codes[] = {1, 2, 3, 4, 5, 6, 7, 10, 12, 13};
+    if (ee_dbg_install(1) != 0)
+    {
+        return;
+    }
+    for (size_t i = 0; i < SDL_arraysize(codes); i++)
+    {
+        ee_dbg_set_level1_handler(codes[i], exception_screen);
+    }
+}
