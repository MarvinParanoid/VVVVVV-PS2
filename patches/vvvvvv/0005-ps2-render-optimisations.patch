+#ifdef __PS2__
+/* P3: the window is cleared up to three times per frame, but every frame ends
+ * with render() copying the finished frame, without blending, over the whole
+ * window whenever the stretch rectangle is the whole window (always on the
+ * PS2's 320x240 window). */
+bool Graphics::ps2_window_clear_redundant(void)
+{
+    SDL_Rect rect;
+    int w, h;
+    if (!(ps2_opts & PS2_OPT_WINDOW_CLEARS) || SDL_GetRenderTarget(gameScreen.m_renderer) != NULL)
+    {
+        return false;
+    }
+    get_stretch_info(&rect);
+    gameScreen.GetScreenSize(&w, &h);
+    return rect.x == 0 && rect.y == 0 && rect.w == w && rect.h == h;
+}
+#endif
