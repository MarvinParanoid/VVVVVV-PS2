+static stb_vorbis* open_source(int index, int* channels, int* loopbegin, int* looplength)
+{
+    const Source* src = &sources[index];
+    PHYSFS_File* f = PHYSFS_openRead(src->path);
+    SDL_RWops* rw;
+    stb_vorbis* vorbis;
+    stb_vorbis_info info;
+    int err = 0;
+
+    if (f == NULL)
+    {
+        vlog_error("Music: cannot open %s: %s", src->path, PHYSFS_getErrorByCode(PHYSFS_getLastErrorCode()));
+        return NULL;
+    }
+    PHYSFS_setBuffer(f, 32768);
+    if (!PHYSFS_seek(f, (PHYSFS_uint64) src->offset))
+    {
+        vlog_error("Music: cannot seek %s to %lld", src->path, (long long) src->offset);
+        PHYSFS_close(f);
+        return NULL;
+    }
+    rw = PHYSFSRWOPS_makeRWops(f);
+    if (rw == NULL)
+    {
+        PHYSFS_close(f);
+        return NULL;
+    }
+    physfs_read = rw->read;
+    rw->read = yielding_read;
+    /* close_on_free: stb_vorbis closes rw (and the PhysFS handle), also on failure */
+    vorbis = stb_vorbis_open_file_section(rw, 1, &err, NULL, (unsigned int) src->size);
+    if (vorbis == NULL)
+    {
+        vlog_error("Music: Vorbis open failed for source %d (error %d)", index, err);
+        return NULL;
+    }
+    info = stb_vorbis_get_info(vorbis);
+    *channels = info.channels;
+    MusicTrack::parseLoopComments(vorbis, info.sample_rate, loopbegin, looplength);
+    return vorbis;
+}
