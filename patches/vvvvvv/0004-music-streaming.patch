+/* Is `file` (a PhysFS path) seekable cheaply? Plain files are; zip entries
+ * only if STORED. Logs the reason when it is not. */
+static bool seekable(const char* file)
+{
+    const char* real = PHYSFS_getRealDir(file);
+    int method;
+
+    if (real == NULL)
+    {
+        return false;
+    }
+    if (SDL_strlen(real) < 4 || SDL_strcasecmp(real + SDL_strlen(real) - 4, ".zip") != 0)
+    {
+        return true; /* a mounted directory: plain file */
+    }
+    method = zip_entry_method(real, file);
+    if (method == 0)
+    {
+        vlog_info("Music: %s is stored uncompressed in %s; streaming enabled", file, real);
+        return true;
+    }
+    if (method < 0)
+    {
+        vlog_warn("Music: could not read the compression method of %s in %s; trying to stream anyway", file, real);
+        return true;
+    }
+    vlog_error("Music: %s is compressed (zip method %d) in %s.", file, method, real);
+    vlog_error("Music: streaming would need seconds per track start; music is DISABLED.");
+    vlog_error("Music: create a PS2 archive with: scripts/repack-data-zip.py data.zip data-ps2.zip");
+    return false;
+}
