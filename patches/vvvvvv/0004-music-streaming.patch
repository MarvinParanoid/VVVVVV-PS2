+/* Returns the new source index, or -1. */
+static int add_source(const char* path, Sint64 offset, Sint64 size)
+{
+    Source s;
+    SDL_zero(s);
+    SDL_strlcpy(s.path, path, sizeof(s.path));
+    s.offset = offset;
+    s.size = size;
+    if (!probe(&s))
+    {
+        vlog_error("Music: %s @%lld is not a playable Ogg Vorbis stream", path, (long long) offset);
+        return -1;
+    }
+    sources.push_back(s);
+    return (int) sources.size() - 1;
+}
+
+static stb_vorbis* open_source(int index, int* channels, int* loopbegin, int* looplength);
+
+/* Cooperative time slicing (worker thread only). */
+static Uint64 slice_start;
+static Uint64 slice_ticks;
+static Uint32 slice_sleep_ms = 1;
+static volatile bool in_stb = false; /* worker is inside stb_vorbis: arms the yield points */
+static int slice_phase; /* 0 idle/loop, 1 close, 2 open, 3 decode, 4 loop seek */
+
+static void begin_slice(void)
+{
+    slice_start = SDL_GetPerformanceCounter();
+}
+
+static void yield_if_slice_used(void)
+{
+    const Uint64 used = SDL_GetPerformanceCounter() - slice_start;
+    if (used >= slice_ticks)
+    {
+        const Uint32 us = (Uint32) (used * 1000000 / SDL_GetPerformanceFrequency());
+        if (us > stats.max_slice_us)
+        {
+            stats.max_slice_us = us;
+            stats.max_slice_phase = slice_phase;
+        }
+        stats.yields++;
+        SDL_Delay(slice_sleep_ms);
+        begin_slice();
+    }
+}
+
+/* stb_vorbis reads the stream mostly a byte at a time, so the read callback
+ * is the one place that runs regularly inside a long stb_vorbis_open. */
+static size_t (SDLCALL* physfs_read)(SDL_RWops*, void*, size_t, size_t);
+
+static size_t SDLCALL yielding_read(SDL_RWops* rw, void* ptr, size_t size, size_t maxnum)
+{
+    static Uint32 calls = 0;
+    if ((++calls & 63) == 0)
+    {
+        yield_if_slice_used();
+    }
+    return physfs_read(rw, ptr, size, maxnum);
+}
+
+static int SDLCALL worker(void* unused)
+{
+    stb_vorbis* vorbis = NULL;
+    int gen = 0, channels = 2, loopbegin = 0, looplength = 0;
+    bool loop = false, at_end = false, published = true;
+    Sint64 sample_pos = 0;
+    UNUSED(unused);
+
+    /* above the game thread (64 on PS2); see the scheduling note above */
+    SDL_SetThreadPriority(SDL_THREAD_PRIORITY_NORMAL);
+    slice_ticks = SDL_GetPerformanceFrequency() * VVVSTREAM_SLICE_US / 1000000;
+    begin_slice();
+    for (;;)
+    {
+        bool pending, quit, did_work = false;
+        int source = -1, g = 0;
+        bool l = false;
+
+        SDL_LockMutex(lock);
+        quit = cmd_quit;
+        pending = cmd_pending;
+        if (pending)
+        {
+            source = cmd_source;
+            g = cmd_gen;
+            l = cmd_loop;
+            cmd_pending = false;
+        }
+        SDL_UnlockMutex(lock);
+        if (quit)
+        {
+            break;
+        }
+
+        if (pending)
+        {
+            /* close the previous track first: one decoder at a time */
+            SDL_AtomicSet(&ready_gen, 0);
+            slice_phase = 1;
+            VVV_freefunc(stb_vorbis_close, vorbis);
+            at_end = false;
+            gen = g;
+            loop = l;
+            if (source >= 0)
+            {
+                Uint64 t0 = SDL_GetPerformanceCounter();
+                slice_phase = 2;
+                const Uint64 decode_slice = slice_ticks;
+                slice_ticks = SDL_GetPerformanceFrequency() * VVVSTREAM_OPEN_SLICE_US / 1000000;
+                slice_sleep_ms = VVVSTREAM_OPEN_SLEEP_MS;
+                in_stb = true;
+                vorbis = open_source(source, &channels, &loopbegin, &looplength);
+                in_stb = false;
+                slice_ticks = decode_slice;
+                slice_sleep_ms = 1;
+                Uint32 us = (Uint32) ((SDL_GetPerformanceCounter() - t0) * 1000000 / SDL_GetPerformanceFrequency());
+                stats.opens++;
+                stats.last_open_us = us;
+                if (us > stats.max_open_us)
+                {
+                    stats.max_open_us = us;
+                }
+                stats.last_source = source;
+                if (vorbis != NULL)
+                {
+                    ring_channels = channels;
+                    sample_pos = 0;
+                    SDL_AtomicSet(&rpos, 0);
+                    SDL_AtomicSet(&wpos, 0);
+                    SDL_AtomicSet(&eof_gen, 0);
+                    published = false;
+                }
+                else
+                {
+                    stats.open_failures++;
+                }
+            }
+            did_work = true;
+        }
+
+        if (vorbis != NULL && !at_end)
+        {
+            const Uint32 space = VVVSTREAM_RING_FRAMES - ring_fill();
+            if (space >= VVVSTREAM_CHUNK_FRAMES)
+            {
+                const Uint32 w = (Uint32) SDL_AtomicGet(&wpos);
+                const Uint32 at = w % VVVSTREAM_RING_FRAMES;
+                Uint32 frames = SDL_min((Uint32) VVVSTREAM_CHUNK_FRAMES, VVVSTREAM_RING_FRAMES - at);
+                Uint64 t0 = SDL_GetPerformanceCounter();
+                int n;
+                if (looplength > 0)
+                {
+                    frames = (Uint32) SDL_min((Sint64) frames, (Sint64) (loopbegin + looplength) - sample_pos);
+                }
+                slice_phase = 3;
+                in_stb = true;
+                n = frames > 0 ? stb_vorbis_get_samples_float_interleaved(
+                    vorbis, ring_channels, ring + (size_t) at * ring_channels, (int) frames * ring_channels
+                ) : 0;
+                in_stb = false;
+                Uint32 us = (Uint32) ((SDL_GetPerformanceCounter() - t0) * 1000000 / SDL_GetPerformanceFrequency());
+                stats.decode_calls++;
+                stats.decode_us_total += us;
+                if (us > stats.max_decode_us)
+                {
+                    stats.max_decode_us = us;
+                }
+                if (n > 0)
+                {
+                    sample_pos += n;
+                    SDL_MemoryBarrierRelease();
+                    SDL_AtomicSet(&wpos, (int) (w + (Uint32) n));
+                    stats.frames_decoded += n;
+                }
+                else if (loop)
+                {
+                    /* end of track or of its loop region: whole-track loops
+                     * seek to the first audio page, no reopen */
+                    Uint64 s0 = SDL_GetPerformanceCounter();
+                    int ok;
+                    slice_phase = 4;
+                    in_stb = true;
+                    ok = (looplength > 0 || loopbegin > 0)
+                        ? stb_vorbis_seek(vorbis, (unsigned int) loopbegin)
+                        : stb_vorbis_seek_start(vorbis);
+                    in_stb = false;
+                    Uint32 sus = (Uint32) ((SDL_GetPerformanceCounter() - s0) * 1000000 / SDL_GetPerformanceFrequency());
+                    sample_pos = loopbegin;
+                    stats.loops++;
+                    stats.loop_fill_frames = ring_fill();
+                    if (sus > stats.max_loop_seek_us)
+                    {
+                        stats.max_loop_seek_us = sus;
+                    }
+                    if (!ok)
+                    {
+                        vlog_error("Music: loop seek failed; stopping track");
+                        at_end = true;
+                        SDL_AtomicSet(&eof_gen, gen);
+                    }
+                }
+                else
+                {
+                    at_end = true;
+                    SDL_AtomicSet(&eof_gen, gen);
+                }
+                did_work = true;
+            }
+        }
+
+        if (!published && vorbis != NULL && (at_end || ring_fill() >= VVVSTREAM_PREROLL_FRAMES))
+        {
+            SDL_MemoryBarrierRelease();
+            SDL_AtomicSet(&ready_gen, gen);
+            published = true;
+        }
+
+        if (did_work)
+        {
+            yield_if_slice_used();
+        }
+        else
+        {
+            const Uint32 us = (Uint32) ((SDL_GetPerformanceCounter() - slice_start) * 1000000 / SDL_GetPerformanceFrequency());
+            if (us > stats.max_slice_us)
+            {
+                stats.max_slice_us = us;
+                stats.max_slice_phase = slice_phase;
+            }
+            SDL_SemWaitTimeout(wake, 20);
+            begin_slice();
+        }
+    }
+    VVV_freefunc(stb_vorbis_close, vorbis);
+    return 0;
+}
+
+static bool start(void)
+{
+    ring = (float*) SDL_malloc(sizeof(float) * 2 * VVVSTREAM_RING_FRAMES);
+    lock = SDL_CreateMutex();
+    wake = SDL_CreateSemaphore(0);
+    if (ring == NULL || lock == NULL || wake == NULL)
+    {
+        vlog_error("Music: cannot allocate the streaming ring/thread objects");
+        return false;
+    }
+    SDL_AtomicSet(&ready_gen, 0);
+    thread = SDL_CreateThread(worker, "vvvvvv_music", NULL);
+    if (thread == NULL)
+    {
+        vlog_error("Music: cannot start the streaming thread: %s", SDL_GetError());
+        return false;
+    }
+    stats.ring_bytes = sizeof(float) * 2 * VVVSTREAM_RING_FRAMES;
+    return true;
+}
+
+static void stop_thread(void)
+{
+    if (thread != NULL)
+    {
+        SDL_LockMutex(lock);
+        cmd_quit = true;
+        SDL_UnlockMutex(lock);
+        SDL_SemPost(wake);
+        SDL_WaitThread(thread, NULL);
+        thread = NULL;
+    }
+    VVV_freefunc(SDL_DestroySemaphore, wake);
+    VVV_freefunc(SDL_DestroyMutex, lock);
+    VVV_free(ring);
+    VVV_free(voice_buf[0]);
+    VVV_free(voice_buf[1]);
+    voice_buf_size = 0;
+    sources.clear();
+}
+
+/* Main thread: request a track (source >= 0) or silence (-1). Returns the
+ * generation the consumer must match. Latest request wins. */
+static int request(int source, bool loop)
+{
+    int gen;
+    if (lock == NULL)
+    {
+        return 0;
+    }
+    SDL_LockMutex(lock);
+    gen = next_gen++;
+    if (next_gen <= 0)
+    {
+        next_gen = 1;
+    }
+    cmd_source = source;
+    cmd_loop = loop;
+    cmd_gen = gen;
+    cmd_pending = true;
+    SDL_UnlockMutex(lock);
+    SDL_SemPost(wake);
+    return gen;
+}
+
+/* Audio thread: copy up to `frames` frames for generation `gen`. Returns the
+ * number of frames produced; 0 means the (non-looping) track has ended. While
+ * the track is still opening, or on an underrun, silence is produced so the
+ * voice keeps running. */
+static Uint32 consume(float* out, Uint32 frames, int channels, int gen)
+{
+    Uint32 got = 0;
+    if (SDL_AtomicGet(&ready_gen) != gen || ring_channels != channels)
+    {
+        SDL_memset(out, 0, sizeof(float) * frames * channels);
+        stats.priming_buffers++;
+        return frames;
+    }
+    SDL_MemoryBarrierAcquire();
+    {
+        const Uint32 r = (Uint32) SDL_AtomicGet(&rpos);
+        const Uint32 avail = (Uint32) SDL_AtomicGet(&wpos) - r;
+        got = SDL_min(avail, frames);
+        if (got > 0)
+        {
+            const Uint32 at = r % VVVSTREAM_RING_FRAMES;
+            const Uint32 first = SDL_min(got, VVVSTREAM_RING_FRAMES - at);
+            SDL_memcpy(out, ring + (size_t) at * channels, sizeof(float) * first * channels);
+            if (got > first)
+            {
+                SDL_memcpy(out + (size_t) first * channels, ring, sizeof(float) * (got - first) * channels);
+            }
+            SDL_AtomicSet(&rpos, (int) (r + got));
+        }
+        if (avail - got < stats.min_fill_frames || stats.min_fill_frames == 0)
+        {
+            stats.min_fill_frames = avail - got + 1; /* +1: 0 means "not set" */
+        }
+    }
+    SDL_SemPost(wake);
+    if (got < frames)
+    {
+        if (SDL_AtomicGet(&eof_gen) == gen)
+        {
+            return got; /* end of a non-looping track */
+        }
+        SDL_memset(out + (size_t) got * channels, 0, sizeof(float) * (frames - got) * channels);
+        stats.underruns++;
+        stats.underrun_frames += frames - got;
+        return frames;
+    }
+    return frames;
+}
