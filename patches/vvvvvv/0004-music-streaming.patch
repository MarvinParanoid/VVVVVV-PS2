+/* Find the compression method of `entry` in the zip at real path `archive`
+ * by reading its central directory. -1 if it cannot be determined. */
+static int zip_entry_method(const char* archive, const char* entry)
+{
+    SDL_RWops* rw = SDL_RWFromFile(archive, "rb");
+    Sint64 size, tail_start;
+    Uint8* tail;
+    int method = -1;
+    size_t tail_len, i, name_len = SDL_strlen(entry);
+
+    if (rw == NULL)
+    {
+        return -1;
+    }
+    size = SDL_RWsize(rw);
+    tail_len = (size_t) SDL_min(size, (Sint64) (65535 + 22));
+    tail_start = size - (Sint64) tail_len;
+    tail = (Uint8*) SDL_malloc(tail_len);
+    if (tail != NULL && SDL_RWseek(rw, tail_start, RW_SEEK_SET) >= 0
+    && SDL_RWread(rw, tail, 1, tail_len) == tail_len)
+    {
+        for (i = tail_len - 22 + 1; i-- > 0;)
+        {
+            Uint32 eocd_sig;
+            SDL_memcpy(&eocd_sig, tail + i, 4);
+            if (SDL_SwapLE32(eocd_sig) == 0x06054b50) /* end of central directory */
+            {
+                Uint32 cd_size, cd_offset, sig;
+                Uint16 entries, n;
+                SDL_memcpy(&entries, tail + i + 10, 2);
+                SDL_memcpy(&cd_size, tail + i + 12, 4);
+                SDL_memcpy(&cd_offset, tail + i + 16, 4);
+                entries = SDL_SwapLE16(entries);
+                cd_size = SDL_SwapLE32(cd_size);
+                cd_offset = SDL_SwapLE32(cd_offset);
+                Uint8* cd = (Uint8*) SDL_malloc(cd_size);
+                if (cd != NULL && SDL_RWseek(rw, cd_offset, RW_SEEK_SET) >= 0
+                && SDL_RWread(rw, cd, 1, cd_size) == cd_size)
+                {
+                    Uint32 at = 0;
+                    for (n = 0; n < entries && at + 46 <= cd_size; n++)
+                    {
+                        Uint16 m, fn_len, extra_len, comment_len;
+                        SDL_memcpy(&sig, cd + at, 4);
+                        if (SDL_SwapLE32(sig) != 0x02014b50)
+                        {
+                            break;
+                        }
+                        SDL_memcpy(&m, cd + at + 10, 2);
+                        SDL_memcpy(&fn_len, cd + at + 28, 2);
+                        SDL_memcpy(&extra_len, cd + at + 30, 2);
+                        SDL_memcpy(&comment_len, cd + at + 32, 2);
+                        fn_len = SDL_SwapLE16(fn_len);
+                        if (fn_len == name_len && at + 46 + fn_len <= cd_size
+                        && SDL_memcmp(cd + at + 46, entry, name_len) == 0)
+                        {
+                            method = SDL_SwapLE16(m);
+                            break;
+                        }
+                        at += 46 + fn_len + SDL_SwapLE16(extra_len) + SDL_SwapLE16(comment_len);
+                    }
+                }
+                SDL_free(cd);
+                break;
+            }
+        }
+    }
+    SDL_free(tail);
+    SDL_RWclose(rw);
+    return method;
+}
