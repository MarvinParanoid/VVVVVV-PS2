+static void vvvstream_yield_point(void)
+{
+    static Uint32 calls = 0;
+    if ((++calls & 15) == 0 && vvvstream::in_stb)
+    {
+        vvvstream::yield_if_slice_used();
+    }
+}
+
+static void vvvstream_qsort(void* base, size_t num, size_t size, int (*compare)(const void*, const void*))
+{
+    vvvstream_yield_point();
+    SDL_qsort(base, num, size, compare);
+    vvvstream_yield_point();
+}
+
+void MUSIC_GetStreamStats(StreamStats* out)
+{
+    *out = vvvstream::stats;
+    out->ring_fill_frames = vvvstream::thread != NULL ? vvvstream::ring_fill() : 0;
+    out->min_fill_frames = vvvstream::stats.min_fill_frames > 0 ? vvvstream::stats.min_fill_frames - 1 : 0;
+    out->sources = (int) vvvstream::sources.size();
+    out->active = SDL_AtomicGet(&vvvstream::ready_gen) != 0;
+}
+
+void MUSIC_ResetStreamMinFill(void)
+{
+    vvvstream::stats.min_fill_frames = 0;
+}
