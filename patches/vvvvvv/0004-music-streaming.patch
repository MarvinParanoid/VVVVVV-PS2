+/* Read the Vorbis identification header at the start of a track. */
+static bool probe(Source* src)
+{
+    Uint8 buf[128];
+    PHYSFS_File* f = PHYSFS_openRead(src->path);
+    PHYSFS_sint64 n;
+    size_t i;
+
+    if (f == NULL)
+    {
+        return false;
+    }
+    n = (PHYSFS_seek(f, (PHYSFS_uint64) src->offset) != 0)
+        ? PHYSFS_readBytes(f, buf, (PHYSFS_uint64) SDL_min(src->size, (Sint64) sizeof(buf)))
+        : -1;
+    PHYSFS_close(f);
+    for (i = 0; n > 0 && i + 16 <= (size_t) n; i++)
+    {
+        if (buf[i] == 0x01 && SDL_memcmp(buf + i + 1, "vorbis", 6) == 0)
+        {
+            Uint32 rate;
+            src->channels = buf[i + 11];
+            SDL_memcpy(&rate, buf + i + 12, 4);
+            src->rate = (int) SDL_SwapLE32(rate);
+            return src->channels >= 1 && src->channels <= 2 && src->rate > 0;
+        }
+    }
+    return false;
+}
+
+/* Index a blob: name -> {offset,size}, mirroring FILESYSTEM_loadBinaryBlob's
+ * walk (header table, then the data of every valid entry in order). Only the
+ * 7.5 KiB header table is read. */
+struct BlobEntry
+{
+    char name[48];
+    Sint64 offset;
+    Sint64 size;
+};
+static bool index_blob(const char* file, std::vector<BlobEntry>* out)
+{
+    static resourceheader headers[binaryBlob::max_headers];
+    PHYSFS_File* f;
+    Sint64 offset = sizeof(headers), length;
+    int i;
+
+    out->clear();
+    if (!PHYSFS_exists(file))
+    {
+        return false;
+    }
+    f = PHYSFS_openRead(file);
+    if (f == NULL)
+    {
+        vlog_error("Music: cannot open %s: %s", file, PHYSFS_getErrorByCode(PHYSFS_getLastErrorCode()));
+        return false;
+    }
+    length = PHYSFS_fileLength(f);
+    if (PHYSFS_readBytes(f, headers, sizeof(headers)) != (PHYSFS_sint64) sizeof(headers))
+    {
+        vlog_error("Music: %s is too short for a blob header table", file);
+        PHYSFS_close(f);
+        return false;
+    }
+    PHYSFS_close(f);
+    for (i = 0; i < binaryBlob::max_headers; i++)
+    {
+        BlobEntry e;
+        const resourceheader* h = &headers[i];
+        if (h->valid != 1 || h->size < 1)
+        {
+            continue; /* same rule as FILESYSTEM_loadBinaryBlob: skip, no offset advance */
+        }
+        SDL_memcpy(e.name, h->name, sizeof(e.name));
+        e.name[sizeof(e.name) - 1] = '\0';
+        e.offset = offset;
+        e.size = SDL_min((Sint64) h->size, length - offset);
+        offset += h->size;
+        if (e.size > 0)
+        {
+            out->push_back(e);
+        }
+    }
+    vlog_info("Music: indexed %s: %d entries, %lld bytes (header table only read)",
+        file, (int) out->size(), (long long) length);
+    return !out->empty();
+}
