+static int SW_RunCommandQueue(SDL_Renderer *renderer, SDL_RenderCommand *cmd, void *vertices, size_t vertsize)
+{
+#ifdef __PS2__
+    const u64 t0 = GetTimerSystemTime();
+    SDL_RenderCommand *c;
+    int result;
+    for (c = cmd; c; c = c->next) {
+        SW_render_stats.cmds[(unsigned) c->command & 15]++;
+    }
+    result = SW_RunCommandQueueImpl(renderer, cmd, vertices, vertsize);
+    SW_render_stats.queue_us += (GetTimerSystemTime() - t0) * 1000 / (kBUSCLK / 1000);
+    SW_render_stats.runs++;
+    return result;
+#else
+    return SW_RunCommandQueueImpl(renderer, cmd, vertices, vertsize);
+#endif
