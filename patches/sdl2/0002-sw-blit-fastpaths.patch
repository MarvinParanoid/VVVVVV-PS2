+/* SDL_HINT_SW_BLIT_FASTPATHS: bit-exact fast paths for the generic
+ * ARGB8888 -> ARGB8888 "Modulate_Blend" blitter. Cached via hint callback,
+ * read whenever a blit is (re)selected. */
+static SDL_bool SDL_sw_blit_fastpaths = SDL_FALSE;
+static SDL_bool SDL_sw_blit_fastpaths_hooked = SDL_FALSE;
+
+static void SDLCALL SDL_SWBlitFastpathsChanged(void *userdata, const char *name, const char *oldValue, const char *hint)
+{
+    SDL_sw_blit_fastpaths = SDL_GetStringBoolean(hint, SDL_FALSE);
+}
+
+SDL_bool SDL_SWBlitFastpathsEnabled(void)
+{
+    if (!SDL_sw_blit_fastpaths_hooked) {
+        SDL_sw_blit_fastpaths_hooked = SDL_TRUE;
+        SDL_AddHintCallback(SDL_HINT_SW_BLIT_FASTPATHS, SDL_SWBlitFastpathsChanged, NULL);
+    }
+    return SDL_sw_blit_fastpaths;
+}
+
+/* Same arithmetic as SDL_Blit_ARGB8888_ARGB8888_Modulate_Blend (blit_auto)
+ * for flags MODULATE_COLOR [| MODULATE_ALPHA] | BLEND, plus two exact
+ * shortcuts: a source alpha of 0 leaves the destination unchanged, and a
+ * source alpha of 255 writes the modulated source with alpha 255. */
+static void SDL_Blit_ARGB8888_ARGB8888_ModulateBlend_Fast(SDL_BlitInfo *info)
+{
+    const int flags = info->flags;
+    const Uint32 modulateR = info->r;
+    const Uint32 modulateG = info->g;
+    const Uint32 modulateB = info->b;
+    const Uint32 modulateA = info->a;
+    const SDL_bool mod_alpha = (flags & SDL_COPY_MODULATE_ALPHA) ? SDL_TRUE : SDL_FALSE;
+
+    while (info->dst_h--) {
+        const Uint32 *src = (const Uint32 *)info->src;
+        Uint32 *dst = (Uint32 *)info->dst;
+        int n = info->dst_w;
+        while (n--) {
+            const Uint32 srcpixel = *src++;
+            Uint32 srcA = srcpixel >> 24;
+            Uint32 srcR, srcG, srcB;
+            if (mod_alpha) {
+                srcA = (srcA * modulateA) / 255;
+            }
+            if (srcA == 0) {
+                ++dst;
+                continue;
+            }
+            srcR = (((srcpixel >> 16) & 0xFF) * modulateR) / 255;
+            srcG = (((srcpixel >> 8) & 0xFF) * modulateG) / 255;
+            srcB = ((srcpixel & 0xFF) * modulateB) / 255;
+            if (srcA == 255) {
+                *dst++ = 0xFF000000u | (srcR << 16) | (srcG << 8) | srcB;
+            } else {
+                const Uint32 dstpixel = *dst;
+                const Uint32 inv = 255 - srcA;
+                Uint32 dstR = (dstpixel >> 16) & 0xFF, dstG = (dstpixel >> 8) & 0xFF;
+                Uint32 dstB = dstpixel & 0xFF, dstA = dstpixel >> 24;
+                srcR = (srcR * srcA) / 255;
+                srcG = (srcG * srcA) / 255;
+                srcB = (srcB * srcA) / 255;
+                dstR = srcR + (inv * dstR) / 255;
+                dstG = srcG + (inv * dstG) / 255;
+                dstB = srcB + (inv * dstB) / 255;
+                dstA = srcA + (inv * dstA) / 255;
+                *dst++ = (dstA << 24) | (dstR << 16) | (dstG << 8) | dstB;
+            }
+        }
+        info->src += info->src_pitch;
+        info->dst += info->dst_pitch;
+    }
+}
