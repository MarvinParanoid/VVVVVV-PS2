+
 static int PS2_CreateWindow(_THIS, SDL_Window *window)
 {
+    PS2_WindowData *data = (PS2_WindowData *)SDL_calloc(1, sizeof(*data));
+    const char *hint = SDL_GetHint(SDL_HINT_PS2_WINDOW_PIXEL_SIZE);
+    int w, h;
+
+    if (!data) {
+        return SDL_OutOfMemory();
+    }
+    if (hint && SDL_sscanf(hint, "%dx%d", &w, &h) == 2 && w > 0 && h > 0 && w <= 1024 && h <= 1024) {
+        data->pixel_w = w;
+        data->pixel_h = h;
+    }
+    window->driverdata = data;
+
     SDL_SetKeyboardFocus(window);
 
     /* Window has been successfully created */
     return 0;
 }
 
+static void PS2_DestroyWindow(_THIS, SDL_Window *window)
+{
+    SDL_free(window->driverdata);
+    window->driverdata = NULL;
+}
