+/* Diagnostics for the VVVVVV PS2 port's validation tests. Not a public API:
+ * tests declare this struct themselves. Times are in microseconds and
+ * accumulate until the caller resets them. */
+typedef struct
+{
+    uint64_t presents;
+    uint64_t update_us;      /* PS2_UpdateTexture: copy into texture memory */
+    uint64_t queue_build_us; /* RunCommandQueue: building GIF packets, incl. texture upload setup */
+    uint64_t exec_us;        /* gsKit_queue_exec in present: DMA kick (waits for previous GS work) */
+    uint64_t finish_us;      /* gsKit_finish in present: wait for the GS to complete this frame */
+    uint64_t vsync_us;       /* vsync wait in present */
+    uint32_t os_queue_size;  /* bytes per oneshot pool */
