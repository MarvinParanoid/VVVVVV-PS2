+static void PS2_GetWindowSizeInPixels(_THIS, SDL_Window *window, int *w, int *h)
+{
+    PS2_WindowData *data = (PS2_WindowData *)window->driverdata;
+
+    if (data && data->pixel_w) {
+        *w = data->pixel_w;
+        *h = data->pixel_h;
