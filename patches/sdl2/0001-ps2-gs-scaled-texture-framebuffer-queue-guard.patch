+
+PS2_RenderStats PS2_render_stats;
+
+static uint64_t PS2_NowUs(void)
+{
+    return GetTimerSystemTime() * 1000ULL / (kBUSCLK / 1000ULL);
+}
+
+static uint32_t PS2_QueueUsed(const GSQUEUE *q)
+{
+    return (uint32_t)((uint8_t *)q->pool_cur - (uint8_t *)q->pool[q->dbuf]);
+}
+
+static uint32_t PS2_QueueCapacity(const GSQUEUE *q)
+{
+    return (uint32_t)((uint8_t *)q->pool_max[q->dbuf] - (uint8_t *)q->pool[q->dbuf]);
+}
+
+static void PS2_NoteQueuePeaks(GSGLOBAL *gsGlobal)
+{
+    uint32_t os = PS2_QueueUsed(gsGlobal->Os_Queue);
+    uint32_t per = PS2_QueueUsed(gsGlobal->Per_Queue);
+    if (os > PS2_render_stats.os_queue_peak) {
+        PS2_render_stats.os_queue_peak = os;
+    }
+    if (per > PS2_render_stats.per_queue_peak) {
+        PS2_render_stats.per_queue_peak = per;
+    }
+}
+
+/* gsKit does not bounds-check its queues in release builds. Make sure `bytes`
+ * more fit into the current oneshot pool, executing it early if not.
+ * Returns SDL_FALSE if `bytes` cannot fit even into an empty pool. */
+static SDL_bool PS2_EnsureQueueSpace(GSGLOBAL *gsGlobal, uint32_t bytes)
+{
+    GSQUEUE *q = gsGlobal->CurQueue;
+    uint32_t cap = PS2_QueueCapacity(q);
+
+    if (PS2_QueueUsed(q) + bytes + RENDER_QUEUE_SLACK <= cap) {
+        return SDL_TRUE;
+    }
+    PS2_NoteQueuePeaks(gsGlobal);
+    gsKit_queue_exec(gsGlobal);
+    PS2_render_stats.early_flushes++;
+    return PS2_QueueUsed(q) + bytes + RENDER_QUEUE_SLACK <= cap;
+}
+
+/* Largest vertex count (multiple of `multiple`) that fits an empty pool. */
+static int PS2_MaxVerticesPerChunk(GSGLOBAL *gsGlobal, int vertex_bytes, int multiple)
+{
+    int room = (int)PS2_QueueCapacity(gsGlobal->CurQueue) - RENDER_QUEUE_SLACK - RENDER_QUEUE_BIND_BYTES - 256;
+    int n = room / vertex_bytes;
+    return n - (n % multiple);
+}
+
+/* 0..255 -> GS range where 0x80 means 1.0 (255 -> 128 exactly). */
+static uint8_t PS2_ScaleToGS(uint8_t v)
+{
+    return (uint8_t)(((unsigned)v * 128u + 127u) / 255u);
+}
