+/* Start-up progress hook for the VVVVVV PS2 port: the application may define
+ * SDL_PS2_BootMessage() to show these steps (e.g. on a text screen) before
+ * any video is up, so a hang while loading IOP modules or waiting for the
+ * boot device is not just a black screen. */
+__attribute__((weak)) void SDL_PS2_BootMessage(const char *message)
+{
+    (void)message;
+}
