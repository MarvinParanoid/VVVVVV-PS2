+static void SDL_Blit_ABGR8888_ABGR8888_Scale_Fast(SDL_BlitInfo *info)
+{
+    const int flags = info->flags;
+    const SDL_bool mod_color = (flags & SDL_COPY_MODULATE_COLOR) ? SDL_TRUE : SDL_FALSE;
+    const SDL_bool mod_alpha = (flags & SDL_COPY_MODULATE_ALPHA) ? SDL_TRUE : SDL_FALSE;
+    const SDL_bool blend = (flags & SDL_COPY_BLEND) ? SDL_TRUE : SDL_FALSE;
+    const Uint32 modulateR = info->b, modulateG = info->g, modulateB = info->r, modulateA = info->a;
+    Uint64 posy, posx, incy, incx;
+
+    incy = ((Uint64)info->src_h << 16) / info->dst_h;
+    incx = ((Uint64)info->src_w << 16) / info->dst_w;
+    posy = incy / 2;
+
+    while (info->dst_h--) {
+        const Uint8 *row = info->src + (posy >> 16) * info->src_pitch;
+        Uint32 *dst = (Uint32 *)info->dst;
+        int n = info->dst_w;
+        posx = incx / 2;
+        while (n--) {
+            const Uint32 srcpixel = *(const Uint32 *)(row + (posx >> 16) * 4);
+            Uint32 srcA = srcpixel >> 24;
+            Uint32 srcR = (srcpixel >> 16) & 0xFF;
+            Uint32 srcG = (srcpixel >> 8) & 0xFF;
+            Uint32 srcB = srcpixel & 0xFF;
+            posx += incx;
+            if (mod_alpha) {
+                srcA = (srcA * modulateA) / 255;
+            }
+            if (blend && srcA == 0) {
+                ++dst;
+                continue;
+            }
+            if (mod_color) {
+                srcR = (srcR * modulateR) / 255;
+                srcG = (srcG * modulateG) / 255;
+                srcB = (srcB * modulateB) / 255;
+            }
+            if (!blend || srcA == 255) {
+                *dst++ = (srcA << 24) | (srcR << 16) | (srcG << 8) | srcB;
+            } else {
+                const Uint32 dstpixel = *dst;
