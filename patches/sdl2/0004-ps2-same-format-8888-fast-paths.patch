+static void SDL_Blit_8888_X888_Copy(SDL_BlitInfo *info)
+{
+    const size_t length = (size_t)info->dst_w * 4;
+    while (info->dst_h--) {
+        SDL_memcpy(info->dst, info->src, length);
+        info->src += info->src_pitch;
+        info->dst += info->dst_pitch;
+    }
+}
