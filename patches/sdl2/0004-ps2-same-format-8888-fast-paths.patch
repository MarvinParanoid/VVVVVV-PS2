+                Uint32 dstR = (dstpixel >> 16) & 0xFF, dstG = (dstpixel >> 8) & 0xFF;
+                Uint32 dstB = dstpixel & 0xFF, dstA = dstpixel >> 24;
+                srcR = (srcR * srcA) / 255;
+                srcG = (srcG * srcA) / 255;
+                srcB = (srcB * srcA) / 255;
+                dstR = srcR + (inv * dstR) / 255;
+                dstG = srcG + (inv * dstG) / 255;
+                dstB = srcB + (inv * dstB) / 255;
+                dstA = srcA + (inv * dstA) / 255;
+                *dst++ = (dstA << 24) | (dstR << 16) | (dstG << 8) | dstB;
