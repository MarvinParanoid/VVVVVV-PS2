+#ifdef __PS2__
+extern SDL_bool SDL_PS2P3FastpathsEnabled(void); /* SDL_blit.c */
+extern SDL_bool SDL_ps2_p3_fastpaths, SDL_ps2_p3_fastpaths_hooked;
+/* per-copy check without a function call once the hint callback is set up */
+#define PS2_P3_ON() (SDL_ps2_p3_fastpaths_hooked ? SDL_ps2_p3_fastpaths : SDL_PS2P3FastpathsEnabled())
+#endif
+
 static void RenderGetViewportSize(SDL_Renderer *renderer, SDL_FRect *rect)
 {
+#ifdef __PS2__
+    /* Called for every copy; the double divisions are soft-float on the EE.
+     * Reuse the last result while the inputs are bit-identical. */
+    static SDL_Renderer *last_renderer = NULL;
+    static double last_w, last_h;
+    static float last_sx, last_sy, out_w, out_h;
+    if (!PS2_P3_ON()) {
+        rect->x = 0.0f;
+        rect->y = 0.0f;
+        rect->w = (float)(renderer->viewport.w / renderer->scale.x);
+        rect->h = (float)(renderer->viewport.h / renderer->scale.y);
+        return;
+    }
+    union { double d; Uint64 u; } vw, vh, lw, lh;
+    union { float f; Uint32 u; } sx, sy, lsx, lsy;
+    vw.d = renderer->viewport.w;
+    vh.d = renderer->viewport.h;
+    sx.f = renderer->scale.x;
+    sy.f = renderer->scale.y;
+    lw.d = last_w;
+    lh.d = last_h;
+    lsx.f = last_sx;
+    lsy.f = last_sy;
+    if (renderer != last_renderer || vw.u != lw.u || vh.u != lh.u || sx.u != lsx.u || sy.u != lsy.u) {
+        last_renderer = renderer;
+        last_w = renderer->viewport.w;
+        last_h = renderer->viewport.h;
+        last_sx = renderer->scale.x;
+        last_sy = renderer->scale.y;
+        out_w = (float)(renderer->viewport.w / renderer->scale.x);
+        out_h = (float)(renderer->viewport.h / renderer->scale.y);
+    }
+    rect->x = 0.0f;
+    rect->y = 0.0f;
+    rect->w = out_w;
+    rect->h = out_h;
+#else
     rect->x = 0.0f;
     rect->y = 0.0f;
     rect->w = (float)(renderer->viewport.w / renderer->scale.x);
     rect->h = (float)(renderer->viewport.h / renderer->scale.y);
+#endif
 }
 
