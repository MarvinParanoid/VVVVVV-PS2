+/* angle == 0.0 (either sign) without a floating-point compare */
+static SDL_INLINE SDL_bool SDL_AngleIsZero(double angle)
+{
+    Uint64 bits;
+#ifdef __PS2__
+    if (!PS2_P3_ON()) {
+        return SDL_FALSE;
+    }
+#else
+    return SDL_FALSE;
+#endif
+    SDL_memcpy(&bits, &angle, sizeof(bits));
+    return (bits << 1) == 0 ? SDL_TRUE : SDL_FALSE;
+}
