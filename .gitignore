# --- Generated by the build scripts (all reproducible from this repository) ---
# Downloaded/patched source trees (VVVVVV export, SDL tarball and tree),
# CMake build directories, USB package and test copies.
/build/
# Built ELFs, maps and staged game files
/out/
# Frozen release candidates (scripts/freeze-release.sh): they contain built
# binaries; publish them as release assets, never commit them.
/release/
# Emulator runs: logs, CSVs and screenshots. Screenshots show the
# proprietary game graphics, so this folder must never be committed.
/logs/

# --- Proprietary or user-supplied files: never commit ---
# VVVVVV game data (graphics, sounds, music) and repacked copies
data.zip
data-ps2.zip
data-stored.zip
*.vvv
# PS2 BIOS dumps and memory card images
*.bin
*.rom
*.ps2
*.mcd
*.img
*.iso
# Disc/stick images, emulator saves
*.p2s
*.chd

# --- Binaries and captures ---
*.elf
*.irx
*.o
*.a
*.map
*.ppm
*.bmp
*.png
!/docs/**/*.png
*.dis

# --- Runtime files the game or the benchmark writes next to the ELF ---
vvvvvv_ps2.log
fs_smoke.log
bench_results.txt
bench_*.csv
prof_*.txt
golden_*.ppm
savedata/

# --- Tooling and editors ---
__pycache__/
*.pyc
.claude/
.vscode/
.idea/
*.swp
*~
.DS_Store
